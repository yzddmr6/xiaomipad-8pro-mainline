+// SPDX-License-Identifier: MIT
+#include "../util/error.h"
+#include "driver.h"
+#include <algorithm>
+extern "C" {
+#include <libdrm/drm_fourcc.h>
+}
+namespace va {
+bool rgb_format(uint32_t f)
+{
+    return f == VA_FOURCC_RGBA || f == VA_FOURCC_RGBX || f == VA_FOURCC_BGRA || f == VA_FOURCC_BGRX;
+}
+uint32_t rgb_drm_format(uint32_t f)
+{
+    switch (f) {
+    case VA_FOURCC_RGBA:
+        return DRM_FORMAT_ABGR8888;
+    case VA_FOURCC_RGBX:
+        return DRM_FORMAT_XBGR8888;
+    case VA_FOURCC_BGRA:
+        return DRM_FORMAT_ARGB8888;
+    case VA_FOURCC_BGRX:
+        return DRM_FORMAT_XRGB8888;
+    default:
+        throw iris::Error(VA_STATUS_ERROR_UNSUPPORTED_RT_FORMAT, "RGB DRM format");
+    }
+}
+VAStatus queryVideoProcFilters(VADriverContextP ctx, VAContextID id, VAProcFilterType*, unsigned* count)
+{
+    auto& d = data(ctx);
+    std::lock_guard lock(d.mutex);
+    auto i = d.contexts.find(id);
+    if (i == d.contexts.end() || !i->second->processing())
+        return VA_STATUS_ERROR_INVALID_CONTEXT;
+    if (!count)
+        return VA_STATUS_ERROR_INVALID_PARAMETER;
+    *count = 0;
+    return VA_STATUS_SUCCESS;
+}
+VAStatus queryVideoProcFilterCaps(VADriverContextP, VAContextID, VAProcFilterType, void*, unsigned*)
+{
+    return VA_STATUS_ERROR_UNSUPPORTED_FILTER;
+}
+VAStatus queryVideoProcPipelineCaps(
+    VADriverContextP ctx, VAContextID id, VABufferID*, unsigned n, VAProcPipelineCaps* caps)
+{
+    auto& d = data(ctx);
+    std::lock_guard lock(d.mutex);
+    auto i = d.contexts.find(id);
+    if (i == d.contexts.end() || !i->second->processing())
+        return VA_STATUS_ERROR_INVALID_CONTEXT;
+    if (!caps)
+        return VA_STATUS_ERROR_INVALID_PARAMETER;
+    if (n)
+        return VA_STATUS_ERROR_UNSUPPORTED_FILTER;
+    static VAProcColorStandardType in[] = { VAProcColorStandardSRGB };
+    static VAProcColorStandardType out[] = { VAProcColorStandardBT601, VAProcColorStandardBT709 };
+    static uint32_t inputs[] = { VA_FOURCC_RGBA, VA_FOURCC_RGBX, VA_FOURCC_BGRA, VA_FOURCC_BGRX };
+    static uint32_t outputs[] = { VA_FOURCC_NV12 };
+    *caps = {};
+    caps->input_color_standards = in;
+    caps->output_color_standards = out;
+    caps->input_pixel_format = inputs;
+    caps->output_pixel_format = outputs;
+    caps->num_input_color_standards = 1;
+    caps->num_output_color_standards = 2;
+    caps->num_input_pixel_formats = 4;
+    caps->num_output_pixel_formats = 1;
+    caps->pipeline_flags = 0;
+    caps->filter_flags = 0;
+    caps->num_forward_references = 0;
+    caps->num_backward_references = 0;
+    caps->rotation_flags = 0;
+    caps->blend_flags = 0;
+    caps->mirror_flags = 0;
+    caps->num_additional_outputs = 0;
+    caps->min_input_width = caps->min_input_height = caps->min_output_width = caps->min_output_height = 1;
+    caps->max_input_width = caps->max_output_width = d.capabilities.max_width;
+    caps->max_input_height = caps->max_output_height = d.capabilities.max_height;
+    return VA_STATUS_SUCCESS;
+}
+void process_picture(DriverData& d, Context& c, Surface& to)
+{
+    std::shared_ptr<Surface> from;
+    std::shared_ptr<Buffer> parameters;
+    iris::StableBuffer *src, *dst;
+    VAProcPipelineParameterBuffer p;
+    {
+        std::lock_guard lock(d.mutex);
+        parameters = c.vpp_parameters;
+        iris::require(bool(parameters), "missing VPP parameters", VA_STATUS_ERROR_INVALID_PARAMETER);
+        p = c.vpp_snapshot;
+        from = surface(d, p.surface);
+        iris::require(rgb_format(from->fourcc) && to.fourcc == VA_FOURCC_NV12, "VPP supports RGB to NV12 only",
+            VA_STATUS_ERROR_UNSUPPORTED_RT_FORMAT);
+        iris::require(from->width == to.width && from->height == to.height, "VPP does not scale",
+            VA_STATUS_ERROR_INVALID_PARAMETER);
+        auto whole = [&](const VARectangle* r) {
+            return !r || (!r->x && !r->y && r->width == to.width && r->height == to.height);
+        };
+        iris::require(
+            whole(p.surface_region) && whole(p.output_region), "VPP does not crop", VA_STATUS_ERROR_INVALID_PARAMETER);
+        iris::require(!p.num_filters && !p.num_forward_references && !p.num_backward_references && !p.rotation_state
+                && !p.mirror_state && !p.blend_state && !p.num_additional_outputs && !p.input_surface_flag
+                && !p.output_surface_flag && !p.output_hdr_metadata,
+            "VPP filters and transforms are unsupported", VA_STATUS_ERROR_UNSUPPORTED_FILTER);
+        // Scaling quality has no effect for an identity rectangle. Interlaced
+        // input and color-matrix flags would change the conversion and are rejected.
+        iris::require(!(p.filter_flags & ~(VA_FILTER_SCALING_MASK | VA_FILTER_INTERPOLATION_MASK))
+                && !(p.pipeline_flags & ~VA_PROC_PIPELINE_FAST),
+            "VPP flags", VA_STATUS_ERROR_INVALID_PARAMETER);
+        iris::require(
+            p.surface_color_standard == VAProcColorStandardNone || p.surface_color_standard == VAProcColorStandardSRGB,
+            "VPP input color standard", VA_STATUS_ERROR_INVALID_PARAMETER);
+        iris::require(p.input_color_properties.color_range != VA_SOURCE_RANGE_REDUCED,
+            "VPP input must be full-range RGB", VA_STATUS_ERROR_INVALID_PARAMETER);
+        iris::require(p.output_color_standard == VAProcColorStandardNone
+                || p.output_color_standard == VAProcColorStandardBT601
+                || p.output_color_standard == VAProcColorStandardBT709,
+            "VPP output color standard", VA_STATUS_ERROR_INVALID_PARAMETER);
+        iris::require(!p.output_color_properties.chroma_sample_location
+                || p.output_color_properties.chroma_sample_location
+                    == (VA_CHROMA_SITING_VERTICAL_CENTER | VA_CHROMA_SITING_HORIZONTAL_CENTER)
+                || p.output_color_properties.chroma_sample_location
+                    == (VA_CHROMA_SITING_VERTICAL_CENTER | VA_CHROMA_SITING_HORIZONTAL_LEFT),
+            "VPP supports vertically centered chroma", VA_STATUS_ERROR_INVALID_PARAMETER);
+        src = &ensure_stable(d, *from);
+        dst = &ensure_stable(d, to);
+    }
+    d.vpp->convert(*dst, *src, p.output_color_standard == VAProcColorStandardBT709,
+        p.output_color_properties.color_range == VA_SOURCE_RANGE_FULL,
+        p.output_color_properties.chroma_sample_location
+            == (VA_CHROMA_SITING_VERTICAL_CENTER | VA_CHROMA_SITING_HORIZONTAL_CENTER));
+    std::lock_guard lock(d.mutex);
+    to.target.completed = true;
+    to.failed = false;
+    d.trace("va vpp RGB-to-NV12 %ux%u", to.width, to.height);
+}
+}
