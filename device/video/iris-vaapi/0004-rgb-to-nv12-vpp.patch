+// SPDX-License-Identifier: MIT
+// Narrow RGB-to-NV12 converter. EGL state belongs to one worker, never to
+// the caller (which may be inside a browser's own GL context).
+#include "vpp.h"
+#include "../util/error.h"
+#include <condition_variable>
+#include <cstring>
+#include <future>
+#include <mutex>
+#include <thread>
+extern "C" {
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+// clang-format off
+#include <GLES3/gl32.h>
+#include <GLES2/gl2ext.h>
+// clang-format on
+#include <fcntl.h>
+#include <gbm.h>
+#include <libdrm/drm_fourcc.h>
+#include <unistd.h>
+}
+namespace iris {
+namespace {
+    const char* vertex = R"(#version 320 es
+void main() {
+ vec2 p=vec2((gl_VertexID<<1)&2,gl_VertexID&2);
+ gl_Position=vec4(p*2.0-1.0,0.0,1.0);
+})";
+    const char* fragment = R"(#version 320 es
+precision highp float;
+precision highp int;
+uniform sampler2D source;
+uniform ivec2 extent;
+uniform int plane;
+uniform int centered_chroma;
+uniform vec3 weights;
+uniform vec2 yscale;
+uniform vec2 cscale;
+layout(location=0) out vec4 pixel;
+vec3 rgb(ivec2 p) { return texelFetch(source,clamp(p,ivec2(0),extent-1),0).rgb; }
+float luma(vec3 v) { return dot(v,weights); }
+vec2 chroma(ivec2 p) {
+ vec3 v;
+ if(centered_chroma!=0)
+  v=(rgb(p)+rgb(p+ivec2(1,0))+rgb(p+ivec2(0,1))+rgb(p+ivec2(1,1)))*0.25;
+ else
+  v=(rgb(p+ivec2(-1,0))+rgb(p+ivec2(-1,1))+2.0*rgb(p)+2.0*rgb(p+ivec2(0,1))+rgb(p+ivec2(1,0))+rgb(p+ivec2(1,1)))*0.125;
+ float y=luma(v);
+ return vec2((v.b-y)/(2.0*(1.0-weights.b)),(v.r-y)/(2.0*(1.0-weights.r)))*cscale.x+cscale.y;
+}
+void main() {
+ ivec2 p=ivec2(gl_FragCoord.xy);
+ if (plane==0) {
+  p.x*=4;
+  pixel=vec4(luma(rgb(p)),luma(rgb(p+ivec2(1,0))),luma(rgb(p+ivec2(2,0))),luma(rgb(p+ivec2(3,0))))*yscale.x+yscale.y;
+ } else {
+  p*=ivec2(4,2);
+  pixel=vec4(chroma(p),chroma(p+ivec2(2,0)));
+ }
+})";
+    GLuint shader(GLenum kind, const char* source)
+    {
+        GLuint s = glCreateShader(kind);
+        glShaderSource(s, 1, &source, nullptr);
+        glCompileShader(s);
+        GLint ok = 0;
+        glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+        if (!ok) {
+            glDeleteShader(s);
+            throw Error(VA_STATUS_ERROR_OPERATION_FAILED, "VPP shader compilation");
+        }
+        return s;
+    }
+    class Converter {
+        int fd = -1;
+        gbm_device* gbm = nullptr;
+        EGLDisplay display = EGL_NO_DISPLAY;
+        EGLContext context = EGL_NO_CONTEXT;
+        GLuint program = 0;
+        PFNEGLCREATEIMAGEKHRPROC create_image = nullptr;
+        PFNEGLDESTROYIMAGEKHRPROC destroy_image = nullptr;
+        PFNGLEGLIMAGETARGETTEXTURE2DOESPROC bind_image = nullptr;
+        void cleanup() noexcept
+        {
+            if (context != EGL_NO_CONTEXT) {
+                glDeleteProgram(program);
+                eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+                eglDestroyContext(display, context);
+            }
+            if (display != EGL_NO_DISPLAY)
+                eglTerminate(display);
+            if (gbm)
+                gbm_device_destroy(gbm);
+            if (fd >= 0)
+                close(fd);
+            eglReleaseThread();
+        }
+        struct Image {
+            Converter& owner;
+            EGLImageKHR image = EGL_NO_IMAGE_KHR;
+            GLuint texture = 0;
+            Image(
+                Converter& o, int fd, uint32_t format, unsigned width, unsigned height, unsigned pitch, unsigned offset)
+                : owner(o)
+            {
+                const EGLint a[] = { EGL_WIDTH, (EGLint)width, EGL_HEIGHT, (EGLint)height, EGL_LINUX_DRM_FOURCC_EXT,
+                    (EGLint)format, EGL_DMA_BUF_PLANE0_FD_EXT, fd, EGL_DMA_BUF_PLANE0_OFFSET_EXT, (EGLint)offset,
+                    EGL_DMA_BUF_PLANE0_PITCH_EXT, (EGLint)pitch, EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT, 0,
+                    EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT, 0, EGL_NONE };
+                image = owner.create_image(owner.display, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, a);
+                require(image != EGL_NO_IMAGE_KHR, "VPP linear DMA-BUF import");
+                glGenTextures(1, &texture);
+                glBindTexture(GL_TEXTURE_2D, texture);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+                owner.bind_image(GL_TEXTURE_2D, image);
+                if (glGetError() != GL_NO_ERROR) {
+                    glDeleteTextures(1, &texture);
+                    owner.destroy_image(owner.display, image);
+                    throw Error(VA_STATUS_ERROR_OPERATION_FAILED, "VPP texture import");
+                }
+            }
+            ~Image()
+            {
+                glDeleteTextures(1, &texture);
+                owner.destroy_image(owner.display, image);
+            }
+        };
+
+    public:
+        explicit Converter(int render_fd)
+        {
+            try {
+                fd = fcntl(render_fd, F_DUPFD_CLOEXEC, 0);
+                require(fd >= 0, "VPP render node");
+                gbm = gbm_create_device(fd);
+                require(gbm, "VPP GBM device");
+                auto get_display = (PFNEGLGETPLATFORMDISPLAYEXTPROC)eglGetProcAddress("eglGetPlatformDisplayEXT");
+                create_image = (PFNEGLCREATEIMAGEKHRPROC)eglGetProcAddress("eglCreateImageKHR");
+                destroy_image = (PFNEGLDESTROYIMAGEKHRPROC)eglGetProcAddress("eglDestroyImageKHR");
+                bind_image = (PFNGLEGLIMAGETARGETTEXTURE2DOESPROC)eglGetProcAddress("glEGLImageTargetTexture2DOES");
+                require(get_display && create_image && destroy_image && bind_image, "VPP EGL entry points");
+                display = get_display(EGL_PLATFORM_GBM_KHR, gbm, nullptr);
+                require(display != EGL_NO_DISPLAY && eglInitialize(display, nullptr, nullptr), "VPP EGL display");
+                require(eglBindAPI(EGL_OPENGL_ES_API), "VPP GLES API");
+                const EGLint a[] = { EGL_CONTEXT_MAJOR_VERSION_KHR, 3, EGL_CONTEXT_MINOR_VERSION_KHR, 2, EGL_NONE };
+                context = eglCreateContext(display, EGL_NO_CONFIG_KHR, EGL_NO_CONTEXT, a);
+                require(context != EGL_NO_CONTEXT && eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, context),
+                    "VPP GLES context");
+                const char* renderer = (const char*)glGetString(GL_RENDERER);
+                require(renderer && !strstr(renderer, "llvmpipe") && !strstr(renderer, "softpipe"),
+                    "VPP hardware renderer required");
+                GLuint vs = shader(GL_VERTEX_SHADER, vertex), fs = 0;
+                try {
+                    fs = shader(GL_FRAGMENT_SHADER, fragment);
+                } catch (...) {
+                    glDeleteShader(vs);
+                    throw;
+                }
+                program = glCreateProgram();
+                glAttachShader(program, vs);
+                glAttachShader(program, fs);
+                glLinkProgram(program);
+                glDeleteShader(vs);
+                glDeleteShader(fs);
+                GLint ok = 0;
+                glGetProgramiv(program, GL_LINK_STATUS, &ok);
+                require(ok, "VPP shader linking");
+            } catch (...) {
+                cleanup();
+                throw;
+            }
+        }
+        ~Converter() { cleanup(); }
+        void convert(StableBuffer& to, StableBuffer& from, bool bt709, bool full, bool centered)
+        {
+            const auto& s = from.layout();
+            const auto& d = to.layout();
+            require(d.fourcc == VA_FOURCC_NV12 && s.width == d.width && s.height == d.height,
+                "VPP requires equal-size RGB to NV12");
+            uint32_t format;
+            switch (s.fourcc) {
+            case VA_FOURCC_RGBA:
+                format = DRM_FORMAT_ABGR8888;
+                break;
+            case VA_FOURCC_RGBX:
+                format = DRM_FORMAT_XBGR8888;
+                break;
+            case VA_FOURCC_BGRA:
+                format = DRM_FORMAT_ARGB8888;
+                break;
+            case VA_FOURCC_BGRX:
+                format = DRM_FORMAT_XRGB8888;
+                break;
+            default:
+                throw Error(VA_STATUS_ERROR_UNSUPPORTED_RT_FORMAT, "VPP RGB format");
+            }
+            wait_dma_buf(from.fd(), false, 5000);
+            wait_dma_buf(to.fd(), true, 5000);
+            glActiveTexture(GL_TEXTURE0);
+            Image source(*this, from.fd(), format, s.width, s.height, s.stride, s.data_offset);
+            glUseProgram(program);
+            glUniform1i(glGetUniformLocation(program, "source"), 0);
+            glUniform2i(glGetUniformLocation(program, "extent"), s.width, s.height);
+            glUniform1i(glGetUniformLocation(program, "centered_chroma"), centered);
+            glUniform3f(glGetUniformLocation(program, "weights"), bt709 ? 0.2126f : 0.299f, bt709 ? 0.7152f : 0.587f,
+                bt709 ? 0.0722f : 0.114f);
+            glUniform2f(glGetUniformLocation(program, "yscale"), full ? 1.f : 219.f / 255.f, full ? 0.f : 16.f / 255.f);
+            glUniform2f(glGetUniformLocation(program, "cscale"), full ? 1.f : 224.f / 255.f, 128.f / 255.f);
+            GLuint fbo = 0;
+            glGenFramebuffers(1, &fbo);
+            glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+            try {
+                for (unsigned plane = 0; plane < 2; plane++) {
+                    unsigned width = (d.width + 3) / 4, height = plane ? (d.height + 1) / 2 : d.height;
+                    glActiveTexture(GL_TEXTURE1);
+                    Image target(*this, to.fd(), DRM_FORMAT_ABGR8888, width, height, d.stride,
+                        plane ? d.chroma_offset() : d.data_offset);
+                    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, target.texture, 0);
+                    require(
+                        glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE, "VPP output framebuffer");
+                    glActiveTexture(GL_TEXTURE0);
+                    glBindTexture(GL_TEXTURE_2D, source.texture);
+                    glViewport(0, 0, width, height);
+                    glUniform1i(glGetUniformLocation(program, "plane"), plane);
+                    glDrawArrays(GL_TRIANGLES, 0, 3);
+                    glFinish();
+                    require(glGetError() == GL_NO_ERROR, "VPP conversion");
+                    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);
+                }
+            } catch (...) {
+                glDeleteFramebuffers(1, &fbo);
+                throw;
+            }
+            glDeleteFramebuffers(1, &fbo);
+        }
+    };
+    class Worker final : public VppEngine {
+        std::thread thread;
+        std::mutex mutex;
+        std::condition_variable wake;
+        bool stop = false;
+        std::packaged_task<void(Converter&)> task;
+
+    public:
+        explicit Worker(int fd)
+        {
+            std::promise<void> ready;
+            auto f = ready.get_future();
+            thread = std::thread([this, fd, ready = std::move(ready)]() mutable {
+                std::unique_ptr<Converter> c;
+                try {
+                    c = std::make_unique<Converter>(fd);
+                    ready.set_value();
+                } catch (...) {
+                    ready.set_exception(std::current_exception());
+                    return;
+                }
+                for (;;) {
+                    std::unique_lock lock(mutex);
+                    wake.wait(lock, [&] { return stop || task.valid(); });
+                    if (stop)
+                        break;
+                    auto t = std::move(task);
+                    lock.unlock();
+                    t(*c);
+                }
+            });
+            try {
+                f.get();
+            } catch (...) {
+                thread.join();
+                throw;
+            }
+        }
+        ~Worker()
+        {
+            {
+                std::lock_guard lock(mutex);
+                stop = true;
+            }
+            wake.notify_one();
+            thread.join();
+        }
+        void convert(StableBuffer& d, StableBuffer& s, bool bt709, bool full, bool centered) override
+        {
+            // The VA context serializes pictures; hold this lock until completion so
+            // a second context cannot overwrite a task waiting for the worker.
+            std::unique_lock lock(mutex);
+            wake.wait(lock, [&] { return !task.valid(); });
+            std::packaged_task<void(Converter&)> t([&](Converter& c) { c.convert(d, s, bt709, full, centered); });
+            auto result = t.get_future();
+            task = std::move(t);
+            wake.notify_all();
+            lock.unlock();
+            result.get();
+            wake.notify_all();
+        }
+    };
+}
+std::unique_ptr<VppEngine> make_vpp(int fd)
+{
+    return std::make_unique<Worker>(fd);
+}
+}
