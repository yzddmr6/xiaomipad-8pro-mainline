From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Sun, 25 Oct 2026 22:22:46 +0300
Subject: [PATCH 24/30] droidvm-shim: iceland gvm: clean the device tree to PoC
 before parsing it (p6)

The shim runs with the MMU off, so its loads bypass the caches; the resource manager adds its /hypervisor nodes
through a cacheable mapping. p6: the shim read the handoff page (0.3-39 fix) and the parcel count, then reported
no gunyah-resource-manager node, while Linux (reading cacheably) finds it in every protected VM. dc civac over the
tree before parsing it (header first, for its size) and again after rewriting /memory; on failure the shim prints
the root node names and the walk error code. shim.bin 13973 bytes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: mzak <mzak.amin@gmail.com>
---
 droidvm-shim/src/fdt.rs        |  51 +++++++++++++++++++++++++++++++++
 droidvm-shim/src/main.rs       |  28 +++++++++++++++++-
 hypervisor/src/gunyah/shim.bin | Bin 13286 -> 13973 bytes
 3 files changed, 78 insertions(+), 1 deletion(-)

diff --git a/droidvm-shim/src/fdt.rs b/droidvm-shim/src/fdt.rs
index e0d533e..fba7626 100644
--- a/droidvm-shim/src/fdt.rs
+++ b/droidvm-shim/src/fdt.rs
@@ -38,6 +38,19 @@ pub enum Error {
     NotFound,
 }
 
+impl Error {
+    /// A number for the handoff page / console (iceland gvm diagnostics).
+    pub fn code(&self) -> u64 {
+        match self {
+            Error::BadMagic => 1,
+            Error::Truncated => 2,
+            Error::BadTag => 3,
+            Error::TooDeep => 4,
+            Error::NotFound => 5,
+        }
+    }
+}
+
 /// What to look for: a node by the name of a direct child of the root, or by a string in some
 /// node's `compatible` list at any depth.
 #[derive(Clone, Copy)]
@@ -192,6 +205,44 @@ impl<'a> Fdt<'a> {
         Err(Error::NotFound)
     }
 
+    /// The blob's length.
+    pub fn len(&self) -> usize {
+        self.blob.len()
+    }
+
+    /// Calls `f` with the name of every direct child of the root (iceland gvm diagnostics).
+    pub fn for_each_root_child(&self, mut f: impl FnMut(&[u8])) {
+        let mut depth = 0usize;
+        let mut p = self.struct_off;
+        let end = self.struct_off + self.struct_len;
+        while p < end {
+            let Ok(tag) = be32(self.blob, p) else { return };
+            p += 4;
+            match tag {
+                FDT_BEGIN_NODE => {
+                    let Ok(name) = cstr(self.blob, p) else { return };
+                    p += (name.len() + 4) & !3;
+                    if depth == 1 {
+                        f(name);
+                    }
+                    depth += 1;
+                }
+                FDT_END_NODE => {
+                    if depth == 0 {
+                        return;
+                    }
+                    depth -= 1;
+                }
+                FDT_PROP => {
+                    let Ok(len) = be32(self.blob, p) else { return };
+                    p += 8 + ((len as usize + 3) & !3);
+                }
+                FDT_NOP => {}
+                _ => return,
+            }
+        }
+    }
+
     pub fn prop_bytes(&self, at: usize, len: usize) -> Result<&[u8], Error> {
         self.blob.get(at..at + len).ok_or(Error::Truncated)
     }
diff --git a/droidvm-shim/src/main.rs b/droidvm-shim/src/main.rs
index ed01b06..42ab238 100644
--- a/droidvm-shim/src/main.rs
+++ b/droidvm-shim/src/main.rs
@@ -223,13 +223,26 @@ pub extern "C" fn shim_main(dtb: *mut u8) -> u64 {
         //
         // SAFETY: the hypervisor handed us this pointer, and the header it starts with says how
         // long it is; every access past this point is bounds-checked against that length.
+        //
+        // iceland gvm (p6): the resource manager adds its own nodes (the /hypervisor one with the
+        // message queues among them) through a cacheable mapping, and this code runs with the MMU
+        // off, so its loads bypass the caches: without cleaning the tree's lines to the point of
+        // coherency first, the shim reads the tree as crosvm wrote it, before the RM touched it
+        // (p6: "no gunyah-resource-manager node", while Linux, reading cacheably, finds it).
+        cache_flush(dtb as u64, 64);
         let blob = unsafe {
             let len = match fdt_total_size(dtb) {
                 Some(l) => l,
                 None => die(0, "the device tree pointer is not a device tree"),
             };
+            cache_flush(dtb as u64, len);
             core::slice::from_raw_parts_mut(dtb, len)
         };
+        uart_str("SHIM: device tree ");
+        uart_hex(dtb as u64);
+        uart_str("+");
+        uart_hex(blob.len() as u64);
+        uart_str("\r\n");
         let mut tree = match fdt::Fdt::new(blob) {
             Ok(t) => t,
             Err(_) => die(0, "the device tree header did not parse"),
@@ -239,7 +252,18 @@ pub extern "C" fn shim_main(dtb: *mut u8) -> u64 {
             "reg",
         ) {
             Ok(hit) => hit,
-            Err(_) => die(0, "no gunyah-resource-manager node in the device tree"),
+            Err(e) => {
+                // What the tree does have at the top, for the next diagnosis.
+                uart_str("SHIM: root nodes:");
+                tree.for_each_root_child(|name| {
+                    uart_str(" ");
+                    for &b in name.iter().take(40) {
+                        uart(b);
+                    }
+                });
+                uart_str("\r\n");
+                die(e.code(), "no gunyah-resource-manager node in the device tree")
+            }
         };
         if len < 16 {
             die(len as u64, "the resource manager node's reg is too short")
@@ -324,6 +348,8 @@ pub extern "C" fn shim_main(dtb: *mut u8) -> u64 {
             if tree.set_memory_window(h.parcel[0].base, total).is_err() {
                 die(0, "could not point /memory at the window")
             }
+            // The tree was written with the MMU off; leave no stale line for Linux to read.
+            cache_flush(dtb as u64, tree.len());
             h.status = SHIM_STATUS_DT_DONE;
             uart_str("SHIM: /memory now ");
             uart_hex(h.parcel[0].base);
