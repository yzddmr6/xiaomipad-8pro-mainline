From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Mon, 26 Oct 2026 01:56:47 +0300
Subject: [PATCH 25/30] droidvm-shim: iceland gvm: RM node lookup by the
 Qualcomm compatibles too, /hypervisor dump on failure (p7)

p7 (q90t4, 0.3-41): the cache clean did not change it; the shim still found no gunyah-resource-manager node (walk
error 5 = not found) although /hypervisor is the first root child and the guest kernel finds that compatible in
normal protected VMs. The shim now also accepts qcom,resource-manager-1-0 / qcom,resource-manager and, if none
matches, prints every node under /hypervisor with its compatible list on the console (row PV-A-0), so the next run
shows what the resource manager really puts there. Host unit test for the subtree walk (6 pass). shim.bin 15359.
For a later release; shared memory mode stays behind its flag in 0.3-43 / 0.2-13.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: mzak <mzak.amin@gmail.com>
---
 droidvm-shim/src/fdt.rs        |  74 +++++++++++++++++++++++++++++++++
 droidvm-shim/src/main.rs       |  26 ++++++++++--
 hypervisor/src/gunyah/shim.bin | Bin 13973 -> 15359 bytes
 3 files changed, 96 insertions(+), 4 deletions(-)

diff --git a/droidvm-shim/src/fdt.rs b/droidvm-shim/src/fdt.rs
index fba7626..e43db5d 100644
--- a/droidvm-shim/src/fdt.rs
+++ b/droidvm-shim/src/fdt.rs
@@ -210,6 +210,64 @@ impl<'a> Fdt<'a> {
         self.blob.len()
     }
 
+    /// Calls `f(depth, node name, compatible)` for every node below the root child `root_child`
+    /// (iceland gvm diagnostics: what the resource manager really put under /hypervisor). The
+    /// compatible is the raw property value (NUL-separated list), empty when the node has none.
+    pub fn for_each_node_under(&self, root_child: &str, mut f: impl FnMut(usize, &[u8], &[u8])) {
+        let mut depth = 0usize;
+        let mut inside = 0usize; // depth at which the wanted root child opened, 0 = not inside
+        let mut p = self.struct_off;
+        let end = self.struct_off + self.struct_len;
+        let mut pending: Option<(usize, &[u8])> = None;
+        while p < end {
+            let Ok(tag) = be32(self.blob, p) else { return };
+            p += 4;
+            match tag {
+                FDT_BEGIN_NODE => {
+                    if let Some((d, n)) = pending.take() {
+                        f(d, n, &[]);
+                    }
+                    let Ok(name) = cstr(self.blob, p) else { return };
+                    p += (name.len() + 4) & !3;
+                    depth += 1;
+                    if inside == 0 && depth == 2 && name == root_child.as_bytes() {
+                        inside = depth;
+                    }
+                    if inside != 0 && depth >= inside {
+                        pending = Some((depth - inside, name));
+                    }
+                }
+                FDT_END_NODE => {
+                    if let Some((d, n)) = pending.take() {
+                        f(d, n, &[]);
+                    }
+                    if inside != 0 && depth == inside {
+                        return;
+                    }
+                    if depth == 0 {
+                        return;
+                    }
+                    depth -= 1;
+                }
+                FDT_PROP => {
+                    let Ok(len) = be32(self.blob, p) else { return };
+                    let Ok(nameoff) = be32(self.blob, p + 4) else { return };
+                    let val_at = p + 8;
+                    p = val_at + ((len as usize + 3) & !3);
+                    if let Some((d, n)) = pending {
+                        if self.prop_name(nameoff as usize).ok() == Some(&b"compatible"[..]) {
+                            let v = self.blob.get(val_at..val_at + len as usize).unwrap_or(&[]);
+                            f(d, n, v);
+                            pending = None;
+                        }
+                    }
+                }
+                FDT_NOP => {}
+                _ => return,
+            }
+        }
+    }
+
     /// Calls `f` with the name of every direct child of the root (iceland gvm diagnostics).
     pub fn for_each_root_child(&self, mut f: impl FnMut(&[u8])) {
         let mut depth = 0usize;
@@ -347,6 +405,22 @@ mod tests {
         assert_ne!(be64(&reg[0..8]).unwrap(), 0x8000_0000, "the boot region is gone");
     }
 
+    #[test]
+    fn the_hypervisor_subtree_is_listed() {
+        let mut b = blob();
+        let tree = Fdt::new(&mut b).unwrap();
+        let mut seen = 0;
+        let mut rm = false;
+        tree.for_each_node_under("hypervisor", |_, name, compat| {
+            seen += 1;
+            if name == b"qcom,resource-mgr" && compat.starts_with(b"gunyah-resource-manager") {
+                rm = true;
+            }
+        });
+        assert!(seen >= 4, "hypervisor and its three children");
+        assert!(rm, "the resource manager node and its compatible");
+    }
+
     #[test]
     fn a_corrupt_blob_is_refused_rather_than_walked() {
         let mut b = blob();
diff --git a/droidvm-shim/src/main.rs b/droidvm-shim/src/main.rs
index 42ab238..c7488a3 100644
--- a/droidvm-shim/src/main.rs
+++ b/droidvm-shim/src/main.rs
@@ -247,12 +247,30 @@ pub extern "C" fn shim_main(dtb: *mut u8) -> u64 {
             Ok(t) => t,
             Err(_) => die(0, "the device tree header did not parse"),
         };
-        let (at, len) = match tree.find_prop(
-            fdt::Match::Compatible("gunyah-resource-manager"),
-            "reg",
-        ) {
+        // iceland gvm (p7): the guest kernel finds "gunyah-resource-manager", but the shim did not
+        // (error 5, /hypervisor present). Try the Qualcomm compatibles too, and if none matches print
+        // the whole /hypervisor subtree (names + compatibles) so the next run says what is there.
+        let found = ["gunyah-resource-manager", "qcom,resource-manager-1-0", "qcom,resource-manager"]
+            .iter()
+            .find_map(|c| tree.find_prop(fdt::Match::Compatible(c), "reg").ok());
+        let (at, len) = match found.ok_or(fdt::Error::NotFound) {
             Ok(hit) => hit,
             Err(e) => {
+                uart_str("SHIM: /hypervisor:");
+                tree.for_each_node_under("hypervisor", |d, name, compat| {
+                    uart_str(" [");
+                    uart_hex(d as u64);
+                    uart_str(" ");
+                    for &b in name.iter().take(40) {
+                        uart(b);
+                    }
+                    uart_str(" = ");
+                    for &b in compat.iter().take(60) {
+                        uart(if b == 0 { b'|' } else { b });
+                    }
+                    uart_str("]");
+                });
+                uart_str("\r\n");
                 // What the tree does have at the top, for the next diagnosis.
                 uart_str("SHIM: root nodes:");
                 tree.for_each_root_child(|name| {
