From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Mon, 26 Oct 2026 04:09:01 +0300
Subject: [PATCH 26/30] droidvm-shim: iceland gvm: say which RM node and capids
 it took, bound the queue drain (fix run)

Fix run (0.3-45): the shim printed its device-tree line and then nothing: it found an RM node this time and went
silent before its next print, i.e. in the message-queue drain. It now prints the matched compatible, the reg length
and the capids before draining, and the drain stops after 64 messages. Shared memory mode stays behind its flag.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: mzak <mzak.amin@gmail.com>
---
 droidvm-shim/src/main.rs       |  18 +++++++++++++++++-
 droidvm-shim/src/rm.rs         |   4 +++-
 hypervisor/src/gunyah/shim.bin | Bin 15359 -> 15653 bytes
 3 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/droidvm-shim/src/main.rs b/droidvm-shim/src/main.rs
index c7488a3..41a05d3 100644
--- a/droidvm-shim/src/main.rs
+++ b/droidvm-shim/src/main.rs
@@ -252,7 +252,17 @@ pub extern "C" fn shim_main(dtb: *mut u8) -> u64 {
         // the whole /hypervisor subtree (names + compatibles) so the next run says what is there.
         let found = ["gunyah-resource-manager", "qcom,resource-manager-1-0", "qcom,resource-manager"]
             .iter()
-            .find_map(|c| tree.find_prop(fdt::Match::Compatible(c), "reg").ok());
+            .find_map(|c| {
+                let hit = tree.find_prop(fdt::Match::Compatible(c), "reg").ok()?;
+                // fix run: the shim went silent right after this point; say which node it took
+                uart_str("SHIM: rm node by ");
+                uart_str(c);
+                uart_str(" reg len ");
+                uart_hex(hit.1 as u64);
+                uart_str("
+");
+                Some(hit)
+            });
         let (at, len) = match found.ok_or(fdt::Error::NotFound) {
             Ok(hit) => hit,
             Err(e) => {
@@ -289,6 +299,12 @@ pub extern "C" fn shim_main(dtb: *mut u8) -> u64 {
         let reg = tree.prop_bytes(at, 16).unwrap_or(&[]);
         let tx = fdt::be64(&reg[0..8]).unwrap_or(0);
         let rx = fdt::be64(&reg[8..16]).unwrap_or(0);
+        uart_str("SHIM: rm capids tx ");
+        uart_hex(tx);
+        uart_str(" rx ");
+        uart_hex(rx);
+        uart_str(", draining
+");
         let mut rm = rm::Rm::new(tx, rx);
         uart_str("SHIM: queue had ");
         uart_hex(rm.drain() as u64);
diff --git a/droidvm-shim/src/rm.rs b/droidvm-shim/src/rm.rs
index a4998b7..cf057e9 100644
--- a/droidvm-shim/src/rm.rs
+++ b/droidvm-shim/src/rm.rs
@@ -113,7 +113,8 @@ impl Rm {
     /// how many it dropped, which is worth printing while bringing a device up.
     pub fn drain(&mut self) -> u32 {
         let mut n = 0;
-        loop {
+        // fix run: an unbounded drain may never end if RECV keeps answering OK; 64 is far more than the queue holds
+        while n < 64 {
             // SAFETY: the queue is the one the device tree named, and the buffer is ours.
             let (err, got) = unsafe {
                 hvc(
@@ -130,6 +131,7 @@ impl Rm {
             }
             n += 1;
         }
+        n
     }
 
     /// Take a shared memparcel at a fixed address.
diff --git a/hypervisor/src/gunyah/shim.bin b/hypervisor/src/gunyah/shim.bin
index ed151b4c5bed35d91799958a9c11855d7d8af80e..ef212fa65aebe8898477fa1ea16e980aa3190e13 100755
