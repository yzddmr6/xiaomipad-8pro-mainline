+#ifndef VNC_SERVER_BRIDGE_H
+#define VNC_SERVER_BRIDGE_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct vnc_server vnc_server_t;
+
+
+#define VNC_INPUT_NONE      0
+#define VNC_INPUT_KEY       1
+#define VNC_INPUT_POINTER   2
+
