+// SPDX-License-Identifier: GPL-2.0-or-later
+// Copyright DroidVM contributors
+// Binds LibVNCServer (GPL-2.0-or-later); no LibVNCServer code is included here.
+// Additional permissions apply; see ADDITIONAL-PERMISSIONS in the repository root.
+// iceland gvm: ported from DroidVM dvm-crosvm 849e05f (gpu_display/src) without the H.264 path
+// (vnc_h264_rfb.*: not ported); otherwise unchanged. See CREDITS.
+
+#define _GNU_SOURCE
+#include "vnc_server_bridge.h"
+
+#include <rfb/rfb.h>
+#include <rfb/keysym.h>
