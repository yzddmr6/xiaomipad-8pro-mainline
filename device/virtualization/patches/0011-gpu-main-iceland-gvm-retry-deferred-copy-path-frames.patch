From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mzak <mzak.amin@gmail.com>
Date: Sun, 25 Oct 2026 01:11:50 +0300
Subject: [PATCH 11/30] gpu + main: iceland gvm: retry deferred copy-path
 frames; SIGBUS / SIGSEGV report

- virtio-gpu copy path: when the compositor still holds the next buffer the flush was dropped; an idle guest then
  never flushed again and the window kept an old (often black) frame (vm-run v10b: weston showed its first frame
  only). The dropped resource is remembered and a 30 ms worker timer presents it once a buffer is free
  (GVM-DROP log, power-of-two counts). CROSVM_GVM_REFRESH_MS keeps its meaning (re-present every scanout).
- main: a SIGBUS / SIGSEGV handler prints the thread, the fault address and /proc/self/maps, then re-raises
  (v10b: the Windows guest's crosvm died with SIGBUS and no log line; on Gunyah a host access to lent memory
  faults with SIGBUS).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 devices/src/virtio/gpu/gvm_scanout.rs | 37 ++++++++++++
 devices/src/virtio/gpu/mod.rs         | 14 +++--
 devices/src/virtio/gpu/virtio_gpu.rs  | 10 +++
 src/gvm_sigbus.rs                     | 87 +++++++++++++++++++++++++++
 src/main.rs                           |  4 ++
 5 files changed, 147 insertions(+), 5 deletions(-)
 create mode 100644 src/gvm_sigbus.rs

diff --git a/devices/src/virtio/gpu/gvm_scanout.rs b/devices/src/virtio/gpu/gvm_scanout.rs
index 75510e6..c9a954d 100755
--- a/devices/src/virtio/gpu/gvm_scanout.rs
+++ b/devices/src/virtio/gpu/gvm_scanout.rs
@@ -89,6 +89,43 @@ pub fn trace(text: std::fmt::Arguments) {
     }
 }
 
+static DROPPED: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+static DROPS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// The copy path skipped a flush because the compositor still held the next buffer.
+pub fn dropped(resource_id: u32) {
+    use std::sync::atomic::Ordering::Relaxed;
+    DROPPED.store(resource_id, Relaxed);
+    let n = DROPS.fetch_add(1, Relaxed) + 1;
+    if n.is_power_of_two() {
+        warn!("GVM-DROP {} flushes deferred (compositor held the next buffer), last res={}", n, resource_id);
+    }
+}
+
+/// A frame of this resource reached the window: nothing pending for it any more.
+pub fn presented(resource_id: u32) {
+    let _ = DROPPED.compare_exchange(
+        resource_id,
+        0,
+        std::sync::atomic::Ordering::Relaxed,
+        std::sync::atomic::Ordering::Relaxed,
+    );
+}
+
+/// The resource of a deferred frame, if any (cleared; a new drop sets it again).
+pub fn take_dropped() -> Option<u32> {
+    match DROPPED.swap(0, std::sync::atomic::Ordering::Relaxed) {
+        0 => None,
+        r => Some(r),
+    }
+}
+
+/// CROSVM_GVM_REFRESH_MS set: the refresh timer re-presents every scanout (else it only retries drops).
+pub fn refresh_all() -> bool {
+    static ALL: OnceLock<bool> = OnceLock::new();
+    *ALL.get_or_init(|| std::env::var("CROSVM_GVM_REFRESH_MS").is_ok_and(|v| v.parse::<u64>().is_ok_and(|n| n > 0)))
+}
+
 /// One warn line per event kind and resource (at most 64 lines): which resources the guest flushes and
 /// which one a scanout shows.
 pub fn note(kind: &str, resource_id: u32, text: &str) {
diff --git a/devices/src/virtio/gpu/mod.rs b/devices/src/virtio/gpu/mod.rs
index f46f290..d1254d9 100644
--- a/devices/src/virtio/gpu/mod.rs
+++ b/devices/src/virtio/gpu/mod.rs
@@ -1222,10 +1222,14 @@ impl Worker {
         // iceland gvm: CROSVM_GVM_REFRESH_MS=N re-presents the scanouts every N ms even without a guest flush.
         // vm-run v5 (q90r): continuously rendering GL clients (kmscube) were drawn, idle GL compositors (glamor,
