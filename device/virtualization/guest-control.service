[Unit]
Description=Piano VM poweroff channel
Requires=dev-hvc0.device
# Type=simple starts before multi-user.target; readiness waits inside the process.
# cloud-final is ordered after multi-user.target: do not create a unit ordering cycle.
After=dev-hvc0.device network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/piano-vm-control

[Install]
WantedBy=multi-user.target
