#!/usr/bin/python3
# SPDX-License-Identifier: MIT
"""Rotate piano's Android and Ubuntu boot image sets through slot A from Linux.

Both systems boot from slot A: boot_a, init_boot_a and vendor_boot_a hold one
system's set, the store /var/lib/piano/switch/{ubuntu,ubuntu.prev,android}/
holds the sets as files with SHA256SUMS.  The slot occupant is identified by
the SHA-256 of the three partitions' content, which slot attribute changes in
the GPT do not affect.  Only slot A is accepted and no slot is ever selected;
vbmeta, slot B, the GPT and every other partition are never written.

A write happens only when the current occupant is a known store set, so the
occupant's set is the verified way back: if any write or full-partition
readback fails, that set is written back and the command fails without a
reboot.  The three writes are not atomic.  Content carrying the persistent
Ubuntu marker (piano.boot=persistent) is never archived as Android.

Store contract: only android/, ubuntu/ and ubuntu.prev/ are image sets, each
with boot.img, init_boot.img, vendor_boot.img (each exactly its partition's
size) and SHA256SUMS ("<sha256>  <name>" lines, one per image).  The store
also holds .lock, state.json and switch.log; `status` reports anything else as
stray and nothing here reads it.  The Android-side KernelSU module reads the
same layout.  Subcommands and layout follow liuqin-switch (MIT) and the erhai
switch design; no code is copied.
"""
import argparse
import ctypes
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import pwd
import shutil
import sys
import subprocess

sys.path.insert(0, '/usr/lib/piano/boot')
import piano_bootslot as slot  # noqa: E402

PROG = 'piano-boot-switch'
PROFILE = '/etc/piano/boot-profile.json'
MAP = '/etc/piano/boot-partitions.json'
KIND = {'ubuntu': 'ubuntu', 'ubuntu.prev': 'ubuntu', 'android': 'android'}
STORE_FILES = {'.lock', 'state.json', 'switch.log', '.state.json.tmp'}
TRANSIENT = {'.android.new', '.android.old', '.ubuntu.new'}


class Failed(slot.Refusal):
    """A write was attempted and did not complete as requested."""


def now():
    return datetime.now(timezone.utc).isoformat(timespec='seconds')


def say(host, message, error=False):
    print(f'{PROG}: {message}', file=sys.stderr, flush=True)
    host.log(PROG, message, error)
    log = slot.store(host) / 'switch.log'
    if log.parent.is_dir():
        try:
            with open(log, 'a') as f:
                f.write(f'{now()} {"ERROR " if error else ""}{message}\n')
        except OSError as exc:
            # The journal and stderr already carry the result. A full log
            # filesystem must not interrupt rollback or claim no writes.
            print(f'{PROG}: cannot append switch.log: {exc}', file=sys.stderr, flush=True)
            host.log(PROG, f'cannot append switch.log: {exc}', error=True)


def record(host, command, result, parts, message):
    hashes = slot.slot_hashes(parts)
    sums, _ = slot.known_sums(host)
    state = {'schema': 1, 'time': now(), 'command': command, 'result': result,
             'occupant': slot.occupant(hashes, sums) or 'unknown', 'slot_sha256': hashes,
             'message': message}
    if slot.store(host).is_dir():
        slot.write_json(slot.store(host) / 'state.json', state)
    return state


class Context:
    """Identity, boot LUN, slot-A judgement and the installed partition map."""

    def __init__(self, host, write, check_slot=True):
        host.require_root()
        slot.require_piano(host)
        serial = json.loads(host.path(PROFILE).read_text()).get('serial')
        if not isinstance(serial, str) or not serial or serial != slot.firmware_serial(host):
            raise slot.Refusal('serial-mismatch', 'Firmware serial differs from the installed device profile')
        self.host = host
        self.disk = slot.boot_disk(host, strict=False)
        self.state = slot.slot_state(host, self.disk) if check_slot else None
        mapping = json.loads(host.path(MAP).read_text())
        if len(mapping) != 3 or {r.get('label') for r in mapping} != {n + '_a' for n in slot.NAMES}:
            raise slot.Refusal('map-invalid', f'{MAP} must describe exactly boot_a, init_boot_a, vendor_boot_a')
        mounted = {line.split()[2] for line in host.path('/proc/self/mountinfo').read_text().splitlines()}
        self.parts = {}
        for row in mapping:
            part = self.disk.partition(row['label'])
            if (part.entry.unique_guid != str(row['partuuid']).lower() or row['lun'] != 4 or
                    not self.disk.scsi.endswith(':4') or part.start != row['start_bytes'] or
                    part.size != row['bytes'] or self.disk.primary.disk_guid != str(row['disk_guid']).lower()):
                raise slot.Refusal('map-mismatch', f'{row["label"]}: GPT, LUN or geometry differs from {MAP}')
            if part.dev in mounted:
                raise slot.Refusal('partition-mounted', f'{row["label"]} is mounted')
            self.parts[row['label'][:-2]] = part
        if write:
            for word in slot.kernel_words(host):
                if word.startswith('piano.debug_timeout='):
                    uptime = float(host.path('/proc/uptime').read_text().split()[0])
                    if int(word.split('=', 1)[1]) - uptime < 60:
                        raise slot.Refusal('session-expiring',
                                           'Less than 60 seconds remain in the bounded debug session')


def write_set(parts, directory, sums):
    for n, part in parts.items():
        fd = os.open(part.node, os.O_RDWR | os.O_CLOEXEC)
        try:
            with open(directory / (n + '.img'), 'rb') as src:
                offset = 0
                while chunk := src.read(1 << 20):
                    slot.pwrite_all(fd, chunk, offset)
                    offset += len(chunk)
            if offset != part.size:
                raise OSError(f'{n}.img changed size during the write')
            os.fsync(fd)
            os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
        finally:
            os.close(fd)
        if slot.digest(part.node, part.size) != sums[n + '.img']:
            raise OSError(f'Full readback of {n}_a does not match {directory.name}/SHA256SUMS')


def matches(hashes, sums):
    """Per image: does the slot partition equal this set's SHA256SUMS entry?"""
    return {name: hashes[name] == sums[name] for name in slot.IMAGES}


def stray(host):
    """Store entries outside the contract; reported, never read."""
    store = slot.store(host)
    if not store.is_dir():
        return []
    known = set(slot.SETS) | STORE_FILES | TRANSIENT
    return sorted(e.name for e in store.iterdir() if e.name not in known and not e.name.startswith('.build-'))


def cmd_status(host, args):
    ctx = Context(host, write=False, check_slot=False)
    report = ctx.disk.report()
    report['boot_a'] = slot.flags(ctx.disk.entry('boot_a').attrs)
    report['boot_b'] = slot.flags(ctx.disk.entry('boot_b').attrs)
    try:
        report['slot'] = slot.slot_state(host, ctx.disk)['source']
    except slot.Refusal as error:
        report['slot'] = {'code': error.code, 'message': str(error)}
    hashes = slot.slot_hashes(ctx.parts)
    sums, errors = slot.known_sums(host)
    report['occupant'] = slot.occupant(hashes, sums) or 'unknown'
    report['slot_content'] = slot.heads_kind(slot.slot_heads(ctx.parts)) or 'not-boot-images'
    report['slot_sha256'] = hashes
    report['store'] = {n: ({'sha256': sums[n], 'equals_slot': sums[n] == hashes,
                            'matches_slot': matches(hashes, sums[n])} if n in sums
                           else {'error': errors[n]}) for n in slot.SETS if n in sums or n in errors}
    report['stray'] = stray(host)
    state = slot.store(host) / 'state.json'
    report['last'] = json.loads(state.read_text()) if state.is_file() else None
    return report


def cmd_verify(host, args):
    ctx = Context(host, write=False)
    report = {'slot': ctx.state}
    problems = []
    for name in slot.SETS:
        if name == 'ubuntu.prev' and not (slot.store(host) / name).is_dir():
            continue
        try:
            slot.check_set(host, name, ctx.parts, KIND[name])
            report[name] = 'verified'
        except slot.Refusal as error:
            report[name] = {'code': error.code, 'message': str(error)}
            problems.append(f'{name}: {error}')
    sums, _ = slot.known_sums(host)
    hashes = slot.slot_hashes(ctx.parts)
    report['occupant'] = slot.occupant(hashes, sums) or 'unknown'
    report['matches_slot'] = {n: matches(hashes, sums[n]) for n in sums}
    if report['occupant'] == 'unknown':
        problems.append('slot A holds no known store set (see matches_slot)')
    if ctx.disk.backup_error:
        report['backup_gpt'] = ctx.disk.backup_error
    if problems:
        raise slot.Refusal('verify-failed', '; '.join(problems))
    return report


def require_switch_battery(host):
    helper = Path(slot.__file__).with_name('switch-common.sh')
    result = subprocess.run(['sh', str(helper), '--battery',
                             str(host.path('/sys/class/power_supply'))],
                            capture_output=True, text=True)
    if result.stderr:
        say(host, result.stderr.rstrip(), error=True)
    if result.returncode or not result.stdout.strip().isdigit():
        raise slot.Refusal('battery-unknown',
                           'Cannot read battery charge; switching requires at least 40%. '
                           '无法读取电量，切换需要至少 40%。')
    level = int(result.stdout.strip())
    if level < 40:
        raise slot.Refusal('battery-low',
                           f'Battery {level}%; switching requires at least 40%. '
                           '电量不足，切换需要至少 40%。')


def cmd_switch(host, args):
    target = 'android' if args.command == 'to-android' else 'ubuntu'
    ctx = Context(host, write=not args.dry_run)
    report = {'target': target}
    with slot.slot_lock(host):
        require_switch_battery(host)
        sums, _ = slot.known_sums(host)
        current = slot.occupant(slot.slot_hashes(ctx.parts), sums)
        report['occupant_before'] = current or 'unknown'
        if target == 'ubuntu' and args.only_if_ubuntu and current == 'android':
            report['result'] = 'skipped'
            say(host, 'Slot A holds Android; the new Ubuntu set stays in the store')
            return report
        target_sums = slot.check_set(host, target, ctx.parts, KIND[target])
        if current == target:
            report['result'] = 'unchanged'
            say(host, f'Slot A already holds store/{target}')
            return report
        if current is None:
            raise slot.Refusal('occupant-unknown', 'Slot A holds no known store set; nothing was written. '
                               'Register Android content with `import-android` or the running Ubuntu set '
                               'with `import-ubuntu`')
        rollback_sums = slot.check_set(host, current, ctx.parts, KIND[current])
        report['rollback'] = current
        if args.dry_run:
            report['result'] = 'would-write'
            return report
        directory, rollback = slot.store(host) / target, slot.store(host) / current
        say(host, f'Writing store/{target} into slot A (rollback: store/{current})')
        with slot.signals_blocked():
            try:
                write_set(ctx.parts, directory, target_sums)
                if slot.slot_hashes(ctx.parts) != target_sums:
                    raise OSError('Final partition hashes differ from the target')
                result, message = 'written', f'Slot A now holds store/{target}'
            except Exception as error:  # every failure must attempt the verified way back
                message = f'Writing store/{target} failed: {error}'
                try:
                    errors = []
                    for name, part in ctx.parts.items():
                        try:
                            write_set({name: part}, rollback, rollback_sums)
                        except Exception as restore_error:
                            errors.append(f'{name}: {restore_error}')
                    if errors:
                        raise OSError('; '.join(errors))
                    result, message = 'rolled-back', message + f'; store/{current} was written back'
                except Exception as again:
                    result = 'rollback-failed'
                    message += (f'; writing store/{current} back also failed: {again}. '
                                'Do not reboot into slot A; recover from Fastboot')
            say(host, message, error=result != 'written')
            try:
                state = record(host, args.command, result, ctx.parts, message)
            except (OSError, ValueError, slot.Refusal) as error:
                raise Failed(result if result != 'written' else 'record-failed',
                             f'{message}; could not record final state: {error}; not rebooting') from error
            report['state'] = state
        report['result'] = result
        if result != 'written':
            raise Failed(result, message)
        return report


def copy_set(host, sources, sizes, expected, name):
    """Copy three images into a fresh hidden store directory; returns its path."""
    store = slot.store(host)
    tmp = store / f'.{name}.new'
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir()
    for n in slot.NAMES:
        h = hashlib.sha256()
        with open(sources[n], 'rb', buffering=0) as src, open(tmp / (n + '.img'), 'wb') as dst:
            left = sizes[n]
            while left:
                chunk = src.read(min(left, 1 << 20))
                if not chunk:
                    raise OSError(f'Short read from {sources[n]}')
                h.update(chunk)
                dst.write(chunk)
                left -= len(chunk)
            dst.flush()
            os.fsync(dst.fileno())
        if h.hexdigest() != expected[n + '.img']:
            raise OSError(f'{sources[n]} changed while it was being copied')
    with open(tmp / 'SHA256SUMS', 'w') as f:
        f.write(''.join(f'{expected[n + ".img"]}  {n}.img\n' for n in sorted(slot.NAMES)))
        f.flush()
        os.fsync(f.fileno())
    return tmp


def cmd_import(host, args):
    android = args.command == 'import-android'
    ctx = Context(host, write=False)
    if not android and not args.source and slot.UBUNTU_MARKER not in slot.kernel_words(host):
        raise slot.Refusal('not-persistent-boot', f'import-ubuntu needs a {slot.UBUNTU_MARKER} boot from slot A')
    slot.store(host).mkdir(parents=True, exist_ok=True)
    sizes = {n: ctx.parts[n].size for n in slot.NAMES}
    report = {}
    with slot.slot_lock(host):
        if args.source:
            source = Path(args.source)
            expected = slot.read_sums(source)
            sources = {n: source / (n + '.img') for n in slot.NAMES}
            for n, path in sources.items():
                if not path.is_file() or path.stat().st_size != sizes[n]:
                    raise slot.Refusal('set-size', f'{path} must be a file of exactly {sizes[n]} B')
                if slot.digest(path, sizes[n]) != expected[n + '.img']:
                    raise slot.Refusal('set-digest', f'{path} does not match SHA256SUMS')
            heads = {n: slot.read_head(p) for n, p in sources.items()}
        else:
            sources = {n: ctx.parts[n].node for n in slot.NAMES}
            expected = slot.slot_hashes(ctx.parts)
            heads = slot.slot_heads(ctx.parts)
        kind = slot.heads_kind(heads)
        want = 'android' if android else 'ubuntu'
        if kind != want:
            raise slot.Refusal('ubuntu-content' if kind == 'ubuntu' else 'wrong-content',
                               f'The source holds {kind or "non-boot"} images, not {want}; nothing was imported')
        if not android and not args.source:
            slot.booted_from_slot(host, heads)
        sums, _ = slot.known_sums(host)
        report['source'] = str(args.source) if args.source else 'slot-a'
        report['sha256'] = expected
        candidates = ('android',) if android else slot.UBUNTU_SETS
        existing = slot.occupant(expected, {n: sums[n] for n in candidates if n in sums})
        if existing == 'ubuntu.prev':
            # A rollback import must select the requested set, not merely find it.
            # Validate both stored copies before exchanging their names under
            # the slot lock; RENAME_EXCHANGE never leaves either name absent.
            for name in slot.UBUNTU_SETS:
                slot.check_set(host, name, ctx.parts, 'ubuntu')
            if args.dry_run:
                report['result'] = 'would-import'
                return report
            store = slot.store(host)
            with slot.signals_blocked():
                libc = ctypes.CDLL(None, use_errno=True)
                exchange = libc.renameat2
                exchange.argtypes = [ctypes.c_int, ctypes.c_char_p,
                                     ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
                exchange.restype = ctypes.c_int
                if exchange(-100, os.fsencode(store / 'ubuntu'),
                            -100, os.fsencode(store / 'ubuntu.prev'), 2):
                    err = ctypes.get_errno()
                    raise OSError(err, os.strerror(err))
                fd = os.open(store, os.O_RDONLY | os.O_DIRECTORY)
                try:
                    os.fsync(fd)
                finally:
                    os.close(fd)
                message = 'Promoted store/ubuntu.prev to store/ubuntu'
                report['state'] = record(host, args.command, 'imported', ctx.parts, message)
            report['result'] = 'imported'
            say(host, message)
            return report
        if existing:
            report['result'] = 'unchanged'
            say(host, f'The source already matches store/{existing}')
            return report
        if args.dry_run:
            report['result'] = 'would-import'
            return report
        store = slot.store(host)
        with slot.signals_blocked():
            tmp = copy_set(host, sources, sizes, expected, want)
            if android:
                old = store / '.android.old'
                shutil.rmtree(old, ignore_errors=True)
                if (store / 'android').exists():
                    (store / 'android').rename(old)
                tmp.rename(store / 'android')
                shutil.rmtree(old, ignore_errors=True)
            else:
                shutil.rmtree(store / 'ubuntu.prev', ignore_errors=True)
                if (store / 'ubuntu').exists():
                    (store / 'ubuntu').rename(store / 'ubuntu.prev')
                tmp.rename(store / 'ubuntu')
            message = f'Imported {report["source"]} as store/{want}'
            report['state'] = record(host, args.command, 'imported', ctx.parts, message)
        report['result'] = 'imported'
        say(host, message)
        return report


def notify_failure(host, command, message):
    """Desktop path: tell the pkexec caller what happened, through their session bus."""
    uid = os.environ.get('PKEXEC_UID', '')
    if not uid.isdigit():
        return
    try:
        user = pwd.getpwuid(int(uid)).pw_name
    except KeyError:
        return
    title = 'Switch to Android failed / 切换到 Android 失败' if command == 'to-android' else \
        'Switch to Ubuntu failed / 切换到 Ubuntu 失败'
    body = (message + '\n\nThe tablet was not restarted. 平板未重启。\n'
            'Details / 详情: journalctl -t piano-boot-switch; /var/lib/piano/switch/switch.log')
    host.run(['busctl', '--user', f'--machine={user}@.host', 'call', 'org.freedesktop.Notifications',
              '/org/freedesktop/Notifications', 'org.freedesktop.Notifications', 'Notify', 'susssasa{sv}i',
              PROG, '0', 'dialog-error', title, body, '0', '0', '0'], check=False)


def command_output(host, argv):
    result = host.capture(argv)
    # Keep the command's stderr verbatim, including warnings on success.
    if result.stderr:
        print(result.stderr, end='', file=sys.stderr, flush=True)
        host.log(PROG, result.stderr, error=result.returncode != 0)
    return result


def list_shutdown_inhibitors(host):
    """ListInhibitors returns (what, who, why, mode, uid, pid) tuples."""
    try:
        result = command_output(host, ['busctl', '--system', '--json=short', 'call',
                                      'org.freedesktop.login1', '/org/freedesktop/login1',
                                      'org.freedesktop.login1.Manager', 'ListInhibitors'])
        if result.returncode:
            raise ValueError(f'ListInhibitors exited with status {result.returncode}')
        reply = json.loads(result.stdout)
        if reply['type'] != 'a(ssssuu)':
            raise ValueError('Unexpected ListInhibitors reply type')
        found = False
        for what, who, why, mode, uid, pid in reply['data'][0]:
            if mode == 'block' and 'shutdown' in what.split(':'):
                say(host, f'Shutdown block inhibitor: who={who}; why={why} (uid={uid}, pid={pid})')
                found = True
        if not found:
            say(host, 'No shutdown block inhibitors reported')
    except (OSError, ValueError, KeyError, IndexError, TypeError) as error:
        # The listing is diagnostic; systemctl still decides whether reboot is allowed.
        say(host, f'Could not list shutdown block inhibitors: {error}', error=True)


def reboot(host, args, target):
    list_shutdown_inhibitors(host)
    argv = ['systemctl', 'reboot']
    if args.force:
        argv.append('-i')
        say(host, 'Rebooting with inhibitors ignored (--force); unsaved work may be lost')
    else:
        say(host, 'Rebooting')
    detail = ''
    try:
        result = command_output(host, argv)
        if result.returncode == 0:
            return 0
        detail = result.stderr
    except OSError as error:
        detail = str(error)
        say(host, detail, error=True)
    system = 'Android' if target == 'android' else 'Ubuntu'
    message = (f'Slot A now holds the {target} set, but systemctl reboot failed. '
               f'The tablet was not restarted; the next boot will be {system}. '
               'Save your work and reboot manually')
    if not args.force:
        message += f', or re-run `sudo {PROG} {args.command} --reboot --force` to ignore inhibitors'
    message += '.'
    say(host, message, error=True)
    if args.desktop:
        notify_failure(host, args.command, message + ('\n' + detail if detail else ''))
    return 1


def main(argv=None, host=None):
    ap = argparse.ArgumentParser(prog=PROG, description=__doc__.split('\n\n')[0])
    sub = ap.add_subparsers(dest='command', required=True)
    sub.add_parser('status', help='report slot attributes, the occupant and the store')
    sub.add_parser('verify', help='check every set and the occupant; never writes')
    for name, target in (('to-android', 'Android'), ('to-ubuntu', 'Ubuntu')):
        p = sub.add_parser(name, help=f'write the {target} set into slot A')
        p.add_argument('--dry-run', action='store_true', help='check everything, write nothing')
        p.add_argument('--reboot', action='store_true', help='reboot after the slot holds the set')
        p.add_argument('--force', action='store_true',
                       help='with --reboot/--desktop, ignore inhibitors (systemctl reboot -i); unsaved work may be lost')
        p.add_argument('--desktop', action='store_true',
                       help='desktop entry: reboot on success, notify the pkexec caller on failure')
        if name == 'to-ubuntu':
            p.add_argument('--only-if-ubuntu', action='store_true',
                           help='kernel updates: rewrite only if an Ubuntu set occupies the slot')
    for name, what in (('import-android', 'replace store/android with the slot content or --from DIR'),
                       ('import-ubuntu', 'register the running slot-A set or --from DIR as store/ubuntu '
                        '(store/ubuntu becomes ubuntu.prev)')):
        p = sub.add_parser(name, help=what)
        p.add_argument('--from', dest='source', metavar='DIR',
                       help='directory with boot.img, init_boot.img, vendor_boot.img and SHA256SUMS')
        p.add_argument('--dry-run', action='store_true')
    args = ap.parse_args(argv)
    if getattr(args, 'force', False) and not (args.reboot or args.desktop):
        ap.error('--force requires --reboot or --desktop')
    host = host or slot.Host()
    handler = {'status': cmd_status, 'verify': cmd_verify, 'to-android': cmd_switch, 'to-ubuntu': cmd_switch,
               'import-android': cmd_import, 'import-ubuntu': cmd_import}[args.command]
    try:
        report = handler(host, args)
        rc = 0
    except (slot.Refusal, OSError, ValueError, KeyError) as error:
        code = getattr(error, 'code', 'io-error' if isinstance(error, OSError) else 'invalid-input')
        report = {'result': code if isinstance(error, Failed) else 'refused', 'code': code, 'message': str(error)}
        if not isinstance(error, Failed):
            report['message'] += '; nothing was written' if args.command.startswith(('to-', 'import-')) else ''
        say(host, report['message'], error=True)
        if getattr(args, 'desktop', False):
            notify_failure(host, args.command, report['message'])
        rc = 1
    report = {'tool': PROG, 'command': args.command, **report}
    print(json.dumps(report, indent=2, sort_keys=True), flush=True)
    if rc == 0 and (getattr(args, 'reboot', False) or getattr(args, 'desktop', False)) and \
            not args.dry_run and report.get('result') in ('written', 'unchanged'):
        rc = reboot(host, args, report['target'])
    return rc


if __name__ == '__main__':
    sys.exit(main())
