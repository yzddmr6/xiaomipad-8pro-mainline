From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Subject: [PATCH] Stop callback producers before closing sensor drivers

SSC synchronous close dispatches the main context. A client's disappearance
can therefore re-enter cleanup after an earlier sensor's client table has
already been freed. Detach D-Bus objects, client watches and udev signals
first; close every driver before releasing any shared tables. Reject queued
requests during shutdown and finish pending claims with a disconnected error.

The regression uses a real private D-Bus and a driver whose close dispatches
NameOwnerChanged after the first driver was closed.

Co-Authored-By: gpt-6-astra <noreply@openai.com>
---
diff --git a/src/iio-sensor-proxy.c b/src/iio-sensor-proxy.c
--- a/src/iio-sensor-proxy.c
+++ b/src/iio-sensor-proxy.c
@@ -40,6 +40,8 @@
 	GDBusNodeInfo *introspection_data;
 	GDBusConnection *connection;
 	guint name_id;
+	guint dbus_registration_ids[NUM_SENSOR_TYPES];
+	gboolean shutting_down;
 	int ret;
 
 	PolkitAuthority *auth;
@@ -494,7 +496,7 @@
 	guint i;
 	char *sender;
 
-	if (name == NULL)
+	if (data->shutting_down || name == NULL)
 		return;
 
 	sender = g_strdup (name);
@@ -554,6 +556,12 @@
 {
 	GHashTable *ht;
 	guint watch_id;
+
+	if (data->shutting_down) {
+		g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR,
+			G_DBUS_ERROR_DISCONNECTED, "Sensor service is shutting down");
+		return;
+	}
 
 	g_debug ("Handling driver refcounting method '%s' for %s device",
 		 method_name, driver_type_to_str (driver_type));
@@ -779,7 +787,7 @@
     };
 	guint i;
 
-	g_dbus_connection_register_object (connection,
+	data->dbus_registration_ids[0] = g_dbus_connection_register_object (connection,
 					   SENSOR_PROXY_DBUS_PATH,
 					   data->introspection_data->interfaces[0],
 					   &interface_vtable,
@@ -787,7 +795,7 @@
 					   NULL,
 					   NULL);
 
-	g_dbus_connection_register_object (connection,
+	data->dbus_registration_ids[1] = g_dbus_connection_register_object (connection,
 					   SENSOR_PROXY_COMPASS_DBUS_PATH,
 					   data->introspection_data->interfaces[1],
 					   &compass_interface_vtable,
@@ -1081,14 +1089,44 @@
 	if (data == NULL)
 		return;
 
+	/* SSC close operations iterate the main context. Detach all producers
+	 * before closing any driver, and keep shared state alive until every
+	 * driver has finished. A later driver's close must not re-enter a
+	 * client callback with an earlier driver's table already destroyed. */
+	data->shutting_down = TRUE;
 	if (data->name_id != 0) {
 		g_bus_unown_name (data->name_id);
 		data->name_id = 0;
 	}
-
+	if (data->client != NULL)
+		g_signal_handlers_disconnect_by_data (data->client, data);
+	for (i = 0; i < G_N_ELEMENTS (data->dbus_registration_ids); i++) {
+		if (data->dbus_registration_ids[i] != 0)
+			g_dbus_connection_unregister_object (data->connection,
+				data->dbus_registration_ids[i]);
+	}
 	for (i = 0; i < NUM_SENSOR_TYPES; i++) {
-		if (driver_type_exists (data, i))
+		GPtrArray *pending = data->sensor_startup_dbus_invocations_delayed[i];
+
+		if (data->clients[i] != NULL)
+			g_hash_table_remove_all (data->clients[i]);
+		if (pending != NULL) {
+			for (guint j = 0; j < pending->len; j++)
+				g_dbus_method_invocation_return_error (g_ptr_array_index (pending, j),
+					G_DBUS_ERROR, G_DBUS_ERROR_DISCONNECTED,
+					"Sensor service is shutting down");
+			g_ptr_array_set_size (pending, 0);
+		}
+		data->sensor_startup_dbus_event_delayed[i] = FALSE;
+	}
+
+	for (i = 0; i < NUM_SENSOR_TYPES; i++) {
+		if (DEVICE_FOR_TYPE(i) != NULL)
 			driver_close (DEVICE_FOR_TYPE(i));
+		DEVICE_FOR_TYPE(i) = NULL;
+		DRIVER_FOR_TYPE(i) = NULL;
+	}
+	for (i = 0; i < NUM_SENSOR_TYPES; i++) {
 		g_clear_object (&UDEV_DEVICE_FOR_TYPE(i));
 		g_clear_pointer (&data->clients[i], g_hash_table_unref);
 		g_clear_pointer (&data->sensor_startup_dbus_invocations_delayed[i], g_ptr_array_unref);
@@ -1109,6 +1147,9 @@
 		SensorData  *data)
 {
 	guint i;
+
+	if (data->shutting_down)
+		return;
 
 	g_debug ("Sensor changes: action = %s, device = %s",
 		 action, g_udev_device_get_sysfs_path (device));
