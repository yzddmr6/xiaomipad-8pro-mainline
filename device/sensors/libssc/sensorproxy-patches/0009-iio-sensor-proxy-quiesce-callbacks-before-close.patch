diff --git a/src/test-shutdown.c b/src/test-shutdown.c
new file mode 100644
--- /dev/null
+++ b/src/test-shutdown.c
@@ -0,0 +1,135 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Exercise the actual daemon cleanup with a driver that dispatches the
+ * default main context, as libssc's synchronous close does. */
+#define main sensor_proxy_main
+#include "iio-sensor-proxy.c"
+#undef main
+
+static GDBusConnection *client_connection;
+static gboolean appeared, vanished, deadline_reached;
+static guint client_callbacks, closed_drivers;
+
+static void
+observer_appeared (GDBusConnection *connection, const char *name,
+                  const char *owner, gpointer user_data)
+{
+        appeared = TRUE;
+}
+
+static void
+observer_vanished (GDBusConnection *connection, const char *name,
+                  gpointer user_data)
+{
+        if (appeared)
+                vanished = TRUE;
+}
+
+static void
+watched_client_vanished (GDBusConnection *connection, const char *name,
+                        gpointer user_data)
+{
+        client_callbacks++;
+        client_vanished_cb (connection, name, user_data);
+}
+
+static gboolean
+deadline_cb (gpointer user_data)
+{
+        deadline_reached = TRUE;
+        return G_SOURCE_REMOVE;
+}
+
+static void
+wait_for (gboolean *condition)
+{
+        guint deadline;
+
+        deadline_reached = FALSE;
+        deadline = g_timeout_add_seconds (5, deadline_cb, NULL);
+        while (!*condition && !deadline_reached)
+                g_main_context_iteration (NULL, TRUE);
+        g_assert_true (*condition);
+        g_source_remove (deadline);
+        while (g_main_context_pending (NULL))
+                g_main_context_iteration (NULL, FALSE);
+}
+
+static void
+close_driver (SensorDevice *device)
+{
+        closed_drivers++;
+        g_free (device);
+}
+
+static void
+close_light_stream (SensorDevice *device, gboolean enabled)
+{
+        g_autoptr(GError) error = NULL;
+
+        g_assert_false (enabled);
+        /* The accelerometer is already closed. Deliver a real D-Bus
+         * NameOwnerChanged while the light driver waits for its close. */
+        g_assert_cmpuint (closed_drivers, ==, 1);
+        g_dbus_connection_close_sync (client_connection, NULL, &error);
+        g_assert_no_error (error);
+        wait_for (&vanished);
+}
+
+static void
+shutdown_with_client_disconnect (void)
+{
+        g_autoptr(GTestDBus) bus = g_test_dbus_new (G_TEST_DBUS_NONE);
+        g_autoptr(GError) error = NULL;
+        GDBusConnection *connection;
+        SensorData *data = g_new0 (SensorData, 1);
+        SensorDriver accel = { .type = DRIVER_TYPE_ACCEL, .close = close_driver };
+        SensorDriver light = { .type = DRIVER_TYPE_LIGHT, .close = close_driver,
+                               .set_polling = close_light_stream };
+        guint observer, watch;
+        const char *name;
+
+        g_test_dbus_up (bus);
+        connection = g_dbus_connection_new_for_address_sync (g_test_dbus_get_bus_address (bus),
+                G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT |
+                G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION, NULL, NULL, &error);
+        g_assert_no_error (error);
+        client_connection = g_dbus_connection_new_for_address_sync (g_test_dbus_get_bus_address (bus),
+                G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT |
+                G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION, NULL, NULL, &error);
+        g_assert_no_error (error);
+        name = g_dbus_connection_get_unique_name (client_connection);
+        data->connection = g_object_ref (connection);
+        for (guint i = 0; i < NUM_SENSOR_TYPES; i++) {
+                data->clients[i] = create_clients_hash_table ();
+                data->sensor_startup_dbus_invocations_delayed[i] = g_ptr_array_new ();
+        }
+        data->drivers[DRIVER_TYPE_ACCEL] = &accel;
+        data->devices[DRIVER_TYPE_ACCEL] = g_new0 (SensorDevice, 1);
+        data->devices[DRIVER_TYPE_ACCEL]->drv = &accel;
+        data->drivers[DRIVER_TYPE_LIGHT] = &light;
+        data->devices[DRIVER_TYPE_LIGHT] = g_new0 (SensorDevice, 1);
+        data->devices[DRIVER_TYPE_LIGHT]->drv = &light;
+        watch = g_bus_watch_name_on_connection (connection, name, G_BUS_NAME_WATCHER_FLAGS_NONE,
+                NULL, watched_client_vanished, data, NULL);
+        g_hash_table_insert (data->clients[DRIVER_TYPE_LIGHT], g_strdup (name), GUINT_TO_POINTER (watch));
+        observer = g_bus_watch_name_on_connection (connection, name, G_BUS_NAME_WATCHER_FLAGS_NONE,
+                observer_appeared, observer_vanished, NULL, NULL);
+        wait_for (&appeared);
+        free_sensor_data (data);
+        g_assert_true (vanished);
+        g_assert_cmpuint (client_callbacks, ==, 0);
+        g_assert_cmpuint (closed_drivers, ==, 2);
+        g_bus_unwatch_name (observer);
+        g_clear_object (&client_connection);
+        g_dbus_connection_close_sync (connection, NULL, &error);
+        g_assert_no_error (error);
+        g_object_unref (connection);
+        g_test_dbus_down (bus);
+}
+
+int main (int argc, char **argv)
+{
+        g_test_init (&argc, &argv, NULL);
+        g_test_add_func ("/sensor-proxy/shutdown/client-disconnect", shutdown_with_client_disconnect);
+        return g_test_run ();
+}
