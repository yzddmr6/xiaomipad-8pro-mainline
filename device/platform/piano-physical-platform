#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Adapted from erhai-physical-platform; see NOTICE.
# Establish physical-tablet userspace policy before systemd caches VM identity.
# The kernel OF tree and raw firmware FDT remain intact.
set -eu

if [ "${1:-}" = --verify ]; then
	status=0
	found=$(systemd-detect-virt --vm) || status=$?
	[ "$found" = none ] && [ "$status" = 1 ] || {
		echo "physical platform: VM detection '$found' (rc=$status)" >&2
		exit 1
	}
	manager=$(systemctl show -p Virtualization --value)
	[ -z "$manager" ] || {
		echo "physical platform: PID1 cached '$manager'" >&2
		exit 1
	}
	chassis=$(hostnamectl chassis) || chassis=unknown
	dt_chassis=$(tr '\0' '\n' </sys/firmware/devicetree/base/chassis-type) || dt_chassis=unknown
	echo "PIANO_PHYSICAL_PLATFORM_VERIFIED: fresh detector=none PID1=none chassis=$chassis dt_chassis=$dt_chassis"
	exit 0
fi

sysroot=${1:-/sys}
case "$sysroot" in /*) ;; *) echo 'expected an absolute sysfs path' >&2; exit 2;; esac
base=$sysroot/firmware/devicetree/base
hyper=$base/hypervisor
# QEMU and other boards must keep their own virtualization semantics.
if [ ! -f "$base/compatible" ] || ! tr '\0' '\n' <"$base/compatible" | grep -qx xiaomi,piano; then
	echo 'PIANO_PHYSICAL_PLATFORM_SKIPPED: not a restored piano root'
	exit 0
fi
[ "$(tr '\0' '\n' <"$base/model")" = 'Xiaomi Pad 8 Pro' ]
[ "$(tr '\0' '\n' <"$base/chassis-type")" = tablet ]

if awk -v target="$hyper" '$1=="piano-physical-platform" && $2==target && $3=="tmpfs" {found=1} END {exit !found}' /proc/self/mounts; then
	exit 0
fi
[ -d "$hyper" ] || exit 0
tr '\0' '\n' <"$hyper/compatible" | grep -qx qcom,gunyah-hypervisor
# Independently observed on piano, not copied from another board.
[ "$(od -An -tx1 "$hyper/qcom,gunyah-vm/qcom,vmid" | tr -d ' \n')" = 00000003 ]
for device in "$sysroot"/bus/platform/devices/*; do
	[ -e "$device/driver" ] || continue
	node=$(readlink -f "$device/of_node") || continue
	case "$node" in
		"$hyper"|"$hyper"/*)
			echo "physical platform: $device has a bound Gunyah driver; policy needs review" >&2
			exit 1
			;;
	esac
done
mount -t tmpfs -o ro,nosuid,nodev,noexec,size=4k,mode=0555 piano-physical-platform "$hyper"
echo 'PIANO_PHYSICAL_PLATFORM_APPLIED: unused Gunyah HLOS export isolated before PID1'
