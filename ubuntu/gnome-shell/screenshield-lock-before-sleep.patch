From 557591e321d74db7734f25c49fbe541afdbd13a5 Mon Sep 17 00:00:00 2001
From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Date: Wed, 25 Nov 2026 00:04:37 +0800
Subject: [PATCH 2/2] screenShield: Finish the lock when preparing for sleep

logind holds sleep until the shield's inhibitor is released, which
happens only once the shield is active, that is after the lock screen
has slid in and the lightbox has faded in. User input during that fade
turns the lightbox off; later lock requests return early because the
lock screen is already shown, so the shield stays locked but never
becomes active. Locking with the power button and closing the cover
right after is enough. Every following suspend then waits for logind's
inhibitor timeout with the screen dark and the lid and power button
ignored.

Nothing animated is seen while the system goes to sleep. Lock without
animation when preparing for sleep, and finish a lock that is under way
or whose fade was cancelled. Remove a pending fade so that it does not
blank the lock screen after resume.

The inhibitor followed lock-enabled as well as ubuntu-lock-on-suspend,
but only the latter makes the shell lock for sleep; with lock on suspend
turned off, every suspend waited for the timeout. Follow that key only.
---
 js/ui/screenShield.js | 46 ++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 41 insertions(+), 5 deletions(-)

diff --git a/js/ui/screenShield.js b/js/ui/screenShield.js
index f3c599f..fb50313 100644
--- a/js/ui/screenShield.js
+++ b/js/ui/screenShield.js
@@ -139,6 +139,7 @@ export class ScreenShield extends Signals.EventEmitter {
         this._activationTime = 0;
         this._becameActiveId = 0;
         this._lockTimeoutId = 0;
+        this._fadeTimeoutId = 0;
 
         // The "long" lightbox is used for the longer (20 seconds) fade from session
         // to idle status, the "short" is used for quickly fading to black when locking
@@ -243,8 +244,9 @@ export class ScreenShield extends Signals.EventEmitter {
     }
 
     async _syncInhibitor() {
-        const lockEnabled = this._settings.get_boolean(LOCK_ENABLED_KEY) ||
-                            this._settings.get_boolean(SUSPEND_LOCK_ENABLED_KEY);
+        // The inhibitor gives _prepareForSleep() time to lock; it locks only
+        // when locking on suspend is enabled.
+        const lockEnabled = this._settings.get_boolean(SUSPEND_LOCK_ENABLED_KEY);
         const lockLocked = this._lockSettings.get_boolean(DISABLE_LOCK_KEY);
         const inhibit = !!this._loginSession && this._loginSession.Active &&
                          !this._isActive && lockEnabled && !lockLocked &&
@@ -277,12 +279,40 @@ export class ScreenShield extends Signals.EventEmitter {
         if (aboutToSuspend) {
             this._dialog?.cancel();
             if (this._settings.get_boolean(SUSPEND_LOCK_ENABLED_KEY))
-                this.lock(true);
+                this._lockForSleep();
         } else {
             this._wakeUpScreen();
         }
     }
 
+    _lockForSleep() {
+        // logind holds sleep until our inhibitor is released, which happens
+        // only once the shield is active, after the lock screen has slid in
+        // and the lightbox has faded in. Nothing animated is seen while the
+        // system goes to sleep, so lock without animation. A lock already
+        // under way is finished here: user input during the fade turns the
+        // lightbox off, and later lock requests return early because the
+        // lock screen is shown, so such a shield never becomes active on its
+        // own and sleep would wait for logind's inhibitor timeout.
+        this.lock(false);
+        if (this._lockScreenState === MessageTray.State.HIDDEN || this._isActive)
+            return;
+
+        if (this._fadeTimeoutId) {
+            GLib.source_remove(this._fadeTimeoutId);
+            this._fadeTimeoutId = 0;
+        }
+
+        if (this.lockScreenShown) {
+            this._activateFade(this._shortLightbox, 0);
+            this._setActive(true);
+        } else {
+            this._lockDialogGroup.remove_all_transitions();
+            this._lockDialogGroup.translation_y = 0;
+            this._lockScreenShown({fadeToBlack: true, animateFade: false});
+        }
+    }
+
     _onStatusChanged(status) {
         if (status !== GnomeSession.PresenceStatus.IDLE)
             return;
@@ -524,10 +554,11 @@ export class ScreenShield extends Signals.EventEmitter {
         if (params.fadeToBlack && params.animateFade) {
             // Take a beat
 
-            const id = GLib.timeout_add_once(GLib.PRIORITY_DEFAULT, MANUAL_FADE_TIME, () => {
+            this._fadeTimeoutId = GLib.timeout_add_once(GLib.PRIORITY_DEFAULT, MANUAL_FADE_TIME, () => {
+                this._fadeTimeoutId = 0;
                 this._activateFade(this._shortLightbox, MANUAL_FADE_TIME);
             });
-            GLib.Source.set_name_by_id(id, '[gnome-shell] this._activateFade');
+            GLib.Source.set_name_by_id(this._fadeTimeoutId, '[gnome-shell] this._activateFade');
         } else {
             if (params.fadeToBlack)
                 this._activateFade(this._shortLightbox, 0);
@@ -626,6 +657,11 @@ export class ScreenShield extends Signals.EventEmitter {
             this._lockTimeoutId = 0;
         }
 
+        if (this._fadeTimeoutId) {
+            GLib.source_remove(this._fadeTimeoutId);
+            this._fadeTimeoutId = 0;
+        }
+
         this._activationTime = 0;
         this._setActive(false);
         this._setLocked(false);
