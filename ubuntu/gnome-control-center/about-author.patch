Description: Show the port author and project link on the About page
Author: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Forwarded: not-needed
Last-Update: 2026-11-11
License: GPL-2.0-or-later
 .
 One activatable row at the bottom of Settings > System > About opens the
 project page in the default browser. The group label is chosen from the
 current language because Ubuntu's language packs do not carry it.

--- a/panels/system/about/cc-about-page.blp
+++ b/panels/system/about/cc-about-page.blp
@@ -106,6 +106,20 @@
           activated => $cc_about_page_open_system_details(template);
         }
       }
+
+      Adw.PreferencesGroup author_group {
+        visible: false;
+        Adw.ActionRow author_row {
+          activatable: true;
+          activated => $on_author_row_activated_cb(template);
+
+          [suffix]
+          Image {
+            valign: center;
+            icon-name: "adw-external-link-symbolic";
+          }
+        }
+      }
     };
   };
 }
--- a/panels/system/about/cc-about-page.c
+++ b/panels/system/about/cc-about-page.c
@@ -38,6 +38,9 @@
   GtkPicture      *os_logo;
   AdwActionRow    *os_name_row;
   AdwActionRow    *processor_row;
+  AdwPreferencesGroup *author_group;
+  AdwActionRow    *author_row;
+  char           *author_uri;
 
   AdwDialog       *system_details_window;
   guint            create_system_details_id;
@@ -160,9 +163,45 @@
 }
 
 static void
+on_author_row_activated_cb (CcAboutPage *self)
+{
+  if (self->author_uri != NULL)
+    g_app_info_launch_default_for_uri (self->author_uri, NULL, NULL);
+}
+
+static void
+setup_author_group (CcAboutPage *self)
+{
+  const char * const *languages = g_get_language_names ();
+
+  g_autoptr(GKeyFile) config = g_key_file_new ();
+  g_autofree char *name = NULL;
+  g_autofree char *uri = NULL;
+
+  /* Device integration supplies branding; shared binaries contain no model. */
+  if (!g_key_file_load_from_file (config, "/usr/share/gnome-control-center/port-author.ini",
+                                  G_KEY_FILE_NONE, NULL))
+    return;
+  name = g_key_file_get_string (config, "Author", "Name", NULL);
+  uri = g_key_file_get_string (config, "Author", "URL", NULL);
+  if (name == NULL || *name == '\0' || uri == NULL || !g_str_has_prefix (uri, "https://"))
+    return;
+  self->author_uri = g_steal_pointer (&uri);
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (self->author_row), name);
+  adw_action_row_set_subtitle (self->author_row, self->author_uri);
+  gtk_widget_set_visible (GTK_WIDGET (self->author_group), TRUE);
+
+  /* Not in Ubuntu's language packs, so choose the label here */
+  adw_preferences_group_set_title (self->author_group,
+                                   g_str_has_prefix (languages[0], "zh") ? "作者" : "Author");
+}
+
+static void
 cc_about_page_dispose (GObject *object)
 {
   CcAboutPage *self = CC_ABOUT_PAGE (object);
+
+  g_clear_pointer (&self->author_uri, g_free);
 
   if (self->system_details_window)
     adw_dialog_force_close (self->system_details_window);
@@ -191,9 +230,12 @@
   gtk_widget_class_bind_template_child (widget_class, CcAboutPage, os_logo);
   gtk_widget_class_bind_template_child (widget_class, CcAboutPage, os_name_row);
   gtk_widget_class_bind_template_child (widget_class, CcAboutPage, processor_row);
+  gtk_widget_class_bind_template_child (widget_class, CcAboutPage, author_group);
+  gtk_widget_class_bind_template_child (widget_class, CcAboutPage, author_row);
 
   gtk_widget_class_bind_template_callback (widget_class, cc_about_page_open_system_details);
   gtk_widget_class_bind_template_callback (widget_class, on_donate_button_clicked_cb);
+  gtk_widget_class_bind_template_callback (widget_class, on_author_row_activated_cb);
 }
 
 static void
@@ -204,6 +246,7 @@
   gtk_widget_init_template (GTK_WIDGET (self));
 
   about_page_setup_overview (self);
+  setup_author_group (self);
 
   style_manager = adw_style_manager_get_default ();
   g_signal_connect_object (style_manager, "notify::dark", G_CALLBACK (setup_os_logo), self, G_CONNECT_SWAPPED);
