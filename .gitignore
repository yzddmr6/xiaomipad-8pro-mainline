/cache/
/out/
/sources/
/private/
/tools/local/
__pycache__/
*.pyc
*.deb
.env
/device/piano-thp/build/

# Generated images, archives and modules; build them from the pinned inputs.
*.img
*.dtb
*.dtbo
*.ko
*.cpio
*.cpio.gz
*.squashfs
*.ext4
*.tar
# Signing keys and per-device installation inputs stay with the device owner.
*.pem
*.key
boot-profile.json
boot-partitions.json
layout.json
thp-calibration.json
bluetooth-address
wlan-address
bt-address.txt
wlan-address.txt
# Proprietary firmware bytes and raw touch captures stay out of the repository, except the stock
# firmware tree below firmware/, where every file must be listed in a firmware/piano-*.json lock.
*.bin
*.fw
*.mbn
*.mdt
*.b[0-9a-f][0-9a-f]
*.ntp1
!/firmware/*/**
# SSH keys and touch calibration of a unit, wherever they are written.
id_rsa*
id_ecdsa*
id_ed25519*
authorized_keys
known_hosts
ssh_host_*
*calibration*.json

# Locked upstream source snapshots, with provenance and licenses.
!/third_party/*/source.tar
