#!/usr/bin/python3
# SPDX-License-Identifier: MIT
import gettext
import json
from gi.repository import Gio, GLib
_ = gettext.translation('mainline-update', '/usr/share/locale', fallback=True).gettext
try:
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    args = ('org.mainline.Update1','/org/mainline/Update1','org.mainline.Update1')
    raw = bus.call_sync(*args, 'GetCompletionNotice',None,GLib.VariantType.new('(s)'),Gio.DBusCallFlags.NONE,30000,None).unpack()[0]
    if raw:
        state = json.loads(raw)
        session = Gio.bus_get_sync(Gio.BusType.SESSION,None)
        session.call_sync('org.freedesktop.Notifications','/org/freedesktop/Notifications','org.freedesktop.Notifications','Notify',
            GLib.Variant('(susssasa{sv}i)',('System Update',0,'system-software-update',
                (_('Rolled back to %s') if state['rolled_back'] else _('Updated to %s')) % state['version'],
                _('Reclaimed %.1f MiB') % (state['freed_bytes']/1048576),[],{},-1)),
            None,Gio.DBusCallFlags.NONE,5000,None)
        bus.call_sync(*args,'MarkCompletionNotified',None,None,Gio.DBusCallFlags.NONE,5000,None)
except (GLib.Error, ValueError):
    pass
