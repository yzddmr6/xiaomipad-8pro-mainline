[Unit]
Description=Piano camera daemon
# Wait for capture readiness before PipeWire probes the loopback cameras.
Before=systemd-user-sessions.service display-manager.service

[Service]
Type=notify
RuntimeDirectory=piano-camera
RuntimeDirectoryMode=0755
NotifyAccess=main
EnvironmentFile=-/etc/piano/camera.conf
ExecCondition=/bin/sh -c 'test "$${CAMERA_START:-1}" = 1'
ExecStartPre=/sbin/modprobe v4l2loopback
ExecStart=/usr/lib/piano/piano-camerad
ExecStopPost=/usr/lib/piano/piano-camera-light-off
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
