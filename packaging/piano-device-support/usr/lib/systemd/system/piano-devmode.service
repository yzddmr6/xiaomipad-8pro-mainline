# Developer mode: SSH login over the USB cable.  Off by default; the
# administrator turns it on with `piano-devmode on`, which is
# `systemctl enable --now piano-devmode.service`, and the enablement state is
# the only persisted switch.  The unit is wanted by usb-gadget.target, which
# udev starts once the USB device controller exists.
# Explicit RAM diagnostics (the separate piano-ram-debug package) reserve
# piano.debug=1 and the USB identity; normal products provide developer SSH.
[Unit]
Description=Piano developer mode (SSH over USB)
ConditionKernelCommandLine=!piano.debug=1
Wants=systemd-networkd.service piano-devmode-ssh.socket

[Service]
Type=oneshot
RemainAfterExit=yes
# sshd -t needs the privilege separation directory, as in ssh.service.
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStartPre=/usr/sbin/piano-devmode check
ExecStart=/usr/libexec/piano/devmode-gadget start
ExecStop=/usr/libexec/piano/devmode-gadget stop

[Install]
WantedBy=usb-gadget.target
