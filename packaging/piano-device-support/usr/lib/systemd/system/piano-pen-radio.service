# SPDX-License-Identifier: MIT
[Unit]
Description=Piano Focus Pen Pro radio initialization
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
User=piano-pen
Group=piano-pen
ExecStart=/usr/libexec/piano/piano-pen-radio --profile /usr/share/piano/pen/p81c-radio.json
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
DevicePolicy=closed
DeviceAllow=char-input r
UMask=0077

# Manual opt-in until hardware acceptance; the package does not enable this unit.
[Install]
WantedBy=multi-user.target
