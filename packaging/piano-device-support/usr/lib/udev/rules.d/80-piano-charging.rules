# SPDX-License-Identifier: MIT
# power_supply emits a change immediately after registration. Keep the device's systemd tag and alias on both events.
ACTION=="add|change", SUBSYSTEM=="power_supply", KERNEL=="xiaomi-mca-usb", TAG+="systemd", ENV{SYSTEMD_ALIAS}+="/pianocharger", ENV{SYSTEMD_WANTS}+="piano-charging.service"
