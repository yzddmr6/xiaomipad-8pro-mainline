From 5a9db0be64e090164930593c6cd13d08ad45123f Mon Sep 17 00:00:00 2001
From: Job Noorman <jnoorman@igalia.com>
Date: Fri, 6 Nov 2026 17:20:20 +0100
Subject: [PATCH] ir3: only fold fsat to (sat) on cat2/3 float instructions

We use is_sat_compatible to fold fsat into a (sat) on its src. (sat)
only performs floating point saturation (fsat) on  floating point
instructions and produces a wrong result (e.g., integer saturation) or
is ignored (e.g., bitwise ops) on other instructions. Fix this by only
marking floating point instructions as is_sat_compatible.

Signed-off-by: Job Noorman <jnoorman@igalia.com>
Fixes: 942341bcd01 ("freedreno/ir3: don't lower fsat")
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/46027>

diff --git a/src/freedreno/ir3/instr-a3xx.h b/src/freedreno/ir3/instr-a3xx.h
index f4cf75e83e8..92a39b5711f 100644
--- a/src/freedreno/ir3/instr-a3xx.h
+++ b/src/freedreno/ir3/instr-a3xx.h
@@ -651,24 +651,7 @@ static inline bool
 is_sat_compatible(opc_t opc)
 {
    /* On a6xx saturation doesn't work on cat4 */
-   if (opc_cat(opc) != 2 && opc_cat(opc) != 3)
-      return false;
-
-   switch (opc) {
-   /* On a3xx and a6xx saturation doesn't work on bary.f/flat.b */
-   case OPC_BARY_F:
-   case OPC_FLAT_B:
-   /* On a6xx saturation doesn't work on sel.* */
-   case OPC_SEL_B16:
-   case OPC_SEL_B32:
-   case OPC_SEL_S16:
-   case OPC_SEL_S32:
-   case OPC_SEL_F16:
-   case OPC_SEL_F32:
-      return false;
-   default:
-      return true;
-   }
+   return is_cat2_float(opc) || is_cat3_float(opc);
 }
 
 static inline bool
