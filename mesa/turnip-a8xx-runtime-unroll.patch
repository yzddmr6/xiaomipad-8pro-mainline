+// Exercise the transformed NIR, not a second implementation of the guard.
+#include "nir_constant_expressions.h"
+#include "nir_serialize.h"
+#include <array>
+#include <unordered_map>
+#include <vector>
+
+class nir_runtime_unroll_test : public nir_loop_unroll_test {
+protected:
+   void build(bool unsign = false, bool inclusive = false,
+              bool continue_then = false, unsigned step = 1, bool store = false, unsigned shift = 0, bool constant_start = false)
+   {
+      nir_def *zero = nir_imm_int(&bld, 0);
+      nir_def *init = nir_load_ubo(&bld, 1, 32, zero, zero,
+                                  (gl_access_qualifier)0, 4, 0, 0, 4);
+      nir_def *limit = nir_load_ubo(&bld, 1, 32, zero, nir_imm_int(&bld, 4),
+                                   (gl_access_qualifier)0, 4, 0, 0, 4);
+      if (constant_start) init = zero;
+      nir_def *acc_init = nir_imm_float(&bld, 0.0f);
+      nir_loop *loop = nir_push_loop(&bld);
+      nir_block *pre = nir_cf_node_as_block(nir_cf_node_prev(&loop->cf_node));
+      nir_block *head = nir_loop_first_block(loop);
+      nir_phi_instr *index = nir_phi_instr_create(bld.shader);
+      nir_phi_instr *acc = nir_phi_instr_create(bld.shader);
+      nir_def_init(&index->instr, &index->def, 1, 32);
+      nir_def_init(&acc->instr, &acc->def, 1, 32);
+      nir_phi_instr_add_src(index, pre, init);
+      nir_phi_instr_add_src(acc, pre, acc_init);
+      nir_def *cond = inclusive ?
+         (unsign ? nir_ult(&bld, limit, &index->def) : nir_ilt(&bld, limit, &index->def)) :
+         (unsign ? nir_uge(&bld, &index->def, limit) : nir_ige(&bld, &index->def, limit));
+      if (continue_then) {
+         nir_if *nif = nir_push_if(&bld, nir_inot(&bld, cond));
+         nir_push_else(&bld, nif);
+         nir_jump(&bld, nir_jump_break);
+         nir_pop_if(&bld, nif);
+      } else {
+         nir_break_if(&bld, cond);
+      }
+      nir_def *offset = nir_imul_imm(&bld, &index->def, 4u >> shift);
+      nir_def *value = nir_load_ssbo(&bld, 1, 32, zero, offset,
+         (gl_access_qualifier)(ACCESS_NON_WRITEABLE | ACCESS_CAN_REORDER), 4, 0, shift);
+      bld.fp_math_ctrl = nir_fp_no_fast_math;
+      nir_def *sum = nir_ffma(&bld, value, nir_imm_float(&bld, 1.0), &acc->def);
+      if (store)
+         nir_store_ssbo(&bld, value, zero, offset, 1, (gl_access_qualifier)0, 4, 0, 0);
+      nir_def *next = nir_iadd_imm(&bld, &index->def, step);
+      nir_block *back = nir_cursor_current_block(bld.cursor);
+      nir_phi_instr_add_src(index, back, next);
+      nir_phi_instr_add_src(acc, back, sum);
+      nir_pop_loop(&bld, loop);
+      nir_store_ssbo(&bld, &acc->def, zero, zero, 1, (gl_access_qualifier)0, 4, 0, 0);
+      bld.cursor = nir_after_phis(head);
+      nir_builder_instr_insert(&bld, &index->instr);
+      nir_builder_instr_insert(&bld, &acc->instr);
+      nir_opt_algebraic(bld.shader);
+      nir_opt_constant_folding(bld.shader);
+      nir_validate_shader(bld.shader, "runtime test input");
+   }
+
+   struct result {
+      std::vector<uint64_t> reads;
+      uint32_t sum = 0;
+      bool operator==(const result &o) const { return reads == o.reads && sum == o.sum; }
+   };
+   result run(nir_shader *s, uint32_t start, uint32_t limit)
+   {
+      using value = std::array<nir_const_value, NIR_MAX_VEC_COMPONENTS>;
+      std::unordered_map<nir_def *, value> values;
+      result res;
+      nir_function_impl *impl = nir_shader_get_entrypoint(s);
+      nir_block *block = nir_start_block(impl), *previous = nullptr;
+      unsigned budget = 10000;
+      while (block != impl->end_block && budget > 0) {
+         budget--;
+         std::vector<std::pair<nir_def *, value>> phis;
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_phi) {
+               nir_phi_instr *phi = nir_instr_as_phi(instr);
+               nir_foreach_phi_src(src, phi) {
+                  if (src->pred == previous)
+                     phis.push_back({&phi->def, values.at(src->src.ssa)});
+               }
+            }
+         }
+         for (auto &p : phis) values[p.first] = p.second;
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_load_const) {
+               auto *lc = nir_instr_as_load_const(instr);
+               for (unsigned c = 0; c < lc->def.num_components; c++)
+                  values[&lc->def][c] = lc->value[c];
+            } else if (instr->type == nir_instr_type_alu) {
+               auto *alu = nir_instr_as_alu(instr);
+               value args[4] = {};
+               nir_const_value *ptrs[4] = {args[0].data(), args[1].data(), args[2].data(), args[3].data()};
+               for (unsigned a = 0; a < nir_op_infos[alu->op].num_inputs; a++)
+                  for (unsigned c = 0; c < NIR_MAX_VEC_COMPONENTS; c++)
+                     args[a][c] = values.at(alu->src[a].src.ssa)[alu->src[a].swizzle[c]];
+               nir_eval_const_opcode(alu->op, values[&alu->def].data(), nullptr,
+                                     alu->def.num_components, alu->def.bit_size, ptrs, 0);
+            } else if (instr->type == nir_instr_type_intrinsic) {
+               auto *in = nir_instr_as_intrinsic(instr);
+               if (in->intrinsic == nir_intrinsic_load_ubo) {
+                  values[&in->def][0].u32 = values.at(in->src[1].ssa)[0].u32 ? limit : start;
+               } else if (in->intrinsic == nir_intrinsic_load_ssbo) {
+                  uint64_t offset = uint64_t(values.at(in->src[1].ssa)[0].u32)
+                                    << nir_intrinsic_offset_shift(in);
+                  static const float data[] = {1e20f, 1.0f, -1e20f, 3.0f, -0.5f, 0.25f, 2.0f, -2.0f};
+                  for (unsigned c = 0; c < in->def.num_components; c++) {
+                     res.reads.push_back(offset + 4 * c);
+                     values[&in->def][c].f32 = data[(offset / 4 + c) % 8];
+                     // Compare finite read prefixes of non-terminating loops too.
+                     if (res.reads.size() == 64) return res;
+                  }
+               } else if (in->intrinsic == nir_intrinsic_store_ssbo) {
+                  res.sum = values.at(in->src[0].ssa)[0].u32;
+               } else {
+                  ADD_FAILURE() << "unexpected intrinsic " << in->intrinsic;
+                  return res;
+               }
+            }
+         }
+         nir_if *nif = nir_block_get_following_if(block);
+         nir_block *next = block->successors[nif && !values.at(nif->condition.ssa)[0].b];
+         previous = block;
+         block = next;
+      }
+      EXPECT_GT(budget, 0u);
+      return res;
+   }
+   void compare(bool unsign, bool inclusive, bool continue_then, bool vectorize = false, unsigned shift = 0, bool constant_start = false)
+   {
+      build(unsign, inclusive, continue_then, 1, false, shift, constant_start);
+      nir_shader *original = nir_shader_clone(nullptr, bld.shader);
+      ASSERT_TRUE(nir_opt_loop_unroll_runtime(bld.shader, 4, 64));
+      nir_validate_shader(bld.shader, "runtime unrolled");
+      EXPECT_EQ(count_loops(), 2);
+      EXPECT_FALSE(nir_opt_loop_unroll_runtime(bld.shader, 4, 64));
+      if (vectorize) {
+         bool progress;
+         do {
+            progress = nir_opt_copy_prop(bld.shader);
+            progress |= nir_opt_constant_folding(bld.shader);
+            progress |= nir_opt_algebraic(bld.shader);
+            progress |= nir_opt_dce(bld.shader);
+         } while (progress);
+         nir_load_store_vectorize_options opts = {};
+         opts.modes = nir_var_mem_ssbo;
+         opts.robust_modes = nir_var_mem_ssbo;
+         opts.callback = [](unsigned mul, unsigned offset, unsigned bits,
+                            unsigned components, int64_t hole,
+                            nir_intrinsic_instr *, nir_intrinsic_instr *, void *) {
+            return bits == 32 && components <= 4 && hole == 0 && mul >= 4 && !(offset % 4);
+         };
+         bool merged = nir_opt_load_store_vectorize(bld.shader, &opts);
+         if (constant_start) {
+            EXPECT_TRUE(merged);
+         }
+         nir_validate_shader(bld.shader, "runtime unroll plus vectorization");
+      }
+      for (uint32_t start : {0u, 1u, 3u, 0x3ffffff8u, 0x3fffffffu, 0xfffffff8u, 0x7ffffff8u, 0x80000000u})
+         for (uint32_t count = 0; count <= 12; count++) {
+            auto a = run(original, start, start + count);
+            auto b = run(bld.shader, start, start + count);
+            EXPECT_TRUE(a == b) << "start=" << start << " count=" << count;
+         }
+      EXPECT_TRUE(run(original, 5, 3) == run(bld.shader, 5, 3));
+      ralloc_free(original);
+   }
+};
+TEST_F(nir_runtime_unroll_test, signed_exclusive) { compare(false, false, false); }
+TEST_F(nir_runtime_unroll_test, signed_inclusive) { compare(false, true, false); }
+TEST_F(nir_runtime_unroll_test, unsigned_exclusive) { compare(true, false, false); }
+TEST_F(nir_runtime_unroll_test, unsigned_inclusive) { compare(true, true, false); }
+TEST_F(nir_runtime_unroll_test, continue_then) { compare(false, false, true); }
+TEST_F(nir_runtime_unroll_test, reject_store) { build(false, false, false, 1, true); EXPECT_FALSE(nir_opt_loop_unroll_runtime(bld.shader, 4, 64)); }
+TEST_F(nir_runtime_unroll_test, reject_step) { build(false, false, false, 2); EXPECT_FALSE(nir_opt_loop_unroll_runtime(bld.shader, 4, 64)); }
+TEST_F(nir_runtime_unroll_test, reject_cost) { build(); EXPECT_FALSE(nir_opt_loop_unroll_runtime(bld.shader, 4, 0)); }
+
+TEST_F(nir_runtime_unroll_test, vectorized_byte_offsets) { compare(false, true, false, true); }
+TEST_F(nir_runtime_unroll_test, vectorized_word_offsets) { compare(false, true, false, true, 2); }
+TEST_F(nir_runtime_unroll_test, vectorized_unsigned_word_offsets) { compare(true, false, false, true, 2); }
+TEST_F(nir_runtime_unroll_test, reject_volatile) {
+   build();
+   nir_foreach_block(block, bld.impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type == nir_instr_type_intrinsic) {
+            auto *in = nir_instr_as_intrinsic(instr);
+            if (in->intrinsic == nir_intrinsic_load_ssbo)
+               nir_intrinsic_set_access(in, (gl_access_qualifier)(nir_intrinsic_access(in) | ACCESS_VOLATILE));
+         }
+      }
+   }
+   EXPECT_FALSE(nir_opt_loop_unroll_runtime(bld.shader, 4, 64));
+}
+
+TEST_F(nir_runtime_unroll_test, serialized_marker) {
+   build();
+   ASSERT_TRUE(nir_opt_loop_unroll_runtime(bld.shader, 4, 64));
+   struct blob blob;
+   struct blob_reader reader;
+   blob_init(&blob);
+   nir_serialize(&blob, bld.shader, false);
+   blob_reader_init(&reader, blob.data, blob.size);
+   nir_shader *copy = nir_deserialize(nullptr, bld.shader->options, &reader);
+   EXPECT_FALSE(nir_opt_loop_unroll_runtime(copy, 4, 64));
+   nir_validate_shader(copy, "runtime unroll round trip");
+   EXPECT_TRUE(run(bld.shader, 1, 13) == run(copy, 1, 13));
+   blob_finish(&blob);
+   ralloc_free(copy);
+}
+
+TEST_F(nir_runtime_unroll_test, reject_subgroup) {
+   build();
+   nir_foreach_block(block, bld.impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type == nir_instr_type_intrinsic &&
+             nir_instr_as_intrinsic(instr)->intrinsic == nir_intrinsic_load_ssbo) {
+            bld.cursor = nir_before_instr(instr);
+            nir_load_subgroup_invocation(&bld);
+            EXPECT_FALSE(nir_opt_loop_unroll_runtime(bld.shader, 4, 64));
+            return;
+         }
+      }
+   }
+   FAIL();
+}
+
+TEST_F(nir_runtime_unroll_test, merged_four_tap_reads) { compare(false, false, false, true, 2, true); }
+
+TEST_F(nir_runtime_unroll_test, reject_exit_effects) {
+   build();
+   nir_foreach_block(block, bld.impl) {
+      if (nir_block_ends_in_break(block)) {
+         bld.cursor = nir_before_instr(nir_block_last_instr(block));
+         nir_def *zero = nir_imm_int(&bld, 0);
+         nir_store_ssbo(&bld, zero, zero, zero, 1, (gl_access_qualifier)0, 4, 0, 0);
+         nir_validate_shader(bld.shader, "exit side effect");
+         EXPECT_FALSE(nir_opt_loop_unroll_runtime(bld.shader, 4, 64));
+         return;
+      }
+   }
+   FAIL();
+}
