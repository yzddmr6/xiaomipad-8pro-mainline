+/* Return the per-iteration byte stride of a scalar address expression. */
+static bool
+runtime_stride(nir_loop *loop, nir_def *def, unsigned depth, uint32_t *stride)
+{
+   if (def->num_components != 1 || def->bit_size != 32 || depth > 8)
+      return false;
+
+   unsigned first = nir_loop_first_block(loop)->index;
+   unsigned last = nir_loop_last_block(loop)->index;
+   if (nir_def_instr(def)->block->index < first ||
+       nir_def_instr(def)->block->index > last) {
+      *stride = 0;
+      return true;
+   }
+
+   struct hash_entry *entry =
+      _mesa_hash_table_search(loop->info->induction_vars, def);
+   if (entry) {
+      nir_loop_induction_variable *iv = entry->data;
+      if (nir_def_as_alu(iv->def)->op != nir_op_iadd ||
+          !nir_src_is_const(iv->update_src->src))
+         return false;
+      *stride = nir_src_as_uint(iv->update_src->src);
+      return true;
+   }
+
+   if (nir_def_is_const(def)) {
+      *stride = 0;
+      return true;
+   }
+   if (!nir_def_is_alu(def))
+      return false;
+   nir_alu_instr *alu = nir_def_as_alu(def);
+   if (alu->op != nir_op_iadd && alu->op != nir_op_imul &&
+       alu->op != nir_op_ishl)
+      return false;
+
+   uint32_t a, b;
+   if (!runtime_stride(loop, alu->src[0].src.ssa, depth + 1, &a) ||
+       !runtime_stride(loop, alu->src[1].src.ssa, depth + 1, &b))
+      return false;
+   if (alu->op == nir_op_iadd) {
+      *stride = a + b;
+   } else if (alu->op == nir_op_ishl && nir_src_is_const(alu->src[1].src)) {
+      *stride = a << (nir_src_as_uint(alu->src[1].src) & 31);
+   } else if (alu->op == nir_op_imul && nir_src_is_const(alu->src[1].src)) {
+      *stride = a * nir_src_as_uint(alu->src[1].src);
+   } else if (alu->op == nir_op_imul && nir_src_is_const(alu->src[0].src)) {
+      *stride = b * nir_src_as_uint(alu->src[0].src);
+   } else {
+      return false;
+   }
+   return true;
+}
+
+/* Deliberately small initial scope: straight-line, read-only loops with a
+ * unit-step integer induction variable and at least one adjacent memory load.
+ * Stores, atomics, barriers, subgroup operations and nested control flow must
+ * not be speculated or duplicated by this profitability heuristic.
+ */
+static bool
+runtime_unroll_candidate(nir_loop *loop, unsigned max_cost, unsigned *iv_src)
+{
+   if (loop->partially_unrolled || loop->control == nir_loop_control_dont_unroll ||
+       loop->info->complex_loop || loop->info->limiting_terminator ||
+       !list_is_singular(&loop->info->loop_terminator_list) ||
+       loop->info->instr_cost > max_cost)
+      return false;
+
+   nir_loop_terminator *term = list_first_entry(&loop->info->loop_terminator_list,
+                                               nir_loop_terminator,
+                                               loop_terminator_link);
+   if (!nir_is_trivial_loop_if(term->nif, term->break_block) ||
+       nir_if_first_then_block(term->nif) != nir_if_last_then_block(term->nif) ||
+       nir_if_first_else_block(term->nif) != nir_if_last_else_block(term->nif) ||
+       nir_block_first_instr(term->break_block) != nir_block_last_instr(term->break_block) ||
+       !exec_list_is_empty(&term->continue_from_block->instr_list) ||
+       !nir_def_is_alu(term->nif->condition.ssa))
+      return false;
+   nir_alu_instr *cmp = nir_def_as_alu(term->nif->condition.ssa);
+   if (cmp->op != nir_op_ilt && cmp->op != nir_op_ige &&
+       cmp->op != nir_op_ult && cmp->op != nir_op_uge)
+      return false;
+
+   bool found = false;
+   for (unsigned i = 0; i < 2; i++) {
+      struct hash_entry *entry =
+         _mesa_hash_table_search(loop->info->induction_vars, cmp->src[i].src.ssa);
+      if (!entry)
+         continue;
+      nir_loop_induction_variable *iv = entry->data;
+      nir_def *limit = cmp->src[1 - i].src.ssa;
+      if (iv->basis != cmp->src[i].src.ssa || iv->basis->bit_size != 32 ||
+          iv->basis->num_components != 1 || nir_def_as_alu(iv->def)->op != nir_op_iadd ||
+          !nir_src_is_const(iv->update_src->src) ||
+          nir_src_as_uint(iv->update_src->src) != 1 ||
+          nir_def_instr(limit)->block->index >= nir_loop_first_block(loop)->index)
+         continue;
+      /* Accept i <[=] limit, not loops continuing while i >[=] limit. */
+      bool is_ge = cmp->op == nir_op_ige || cmp->op == nir_op_uge;
+      if ((is_ge ^ (i == 1)) == term->continue_from_then)
+         continue;
+      *iv_src = i;
+      found = true;
+   }
+   if (!found)
+      return false;
+
+   unsigned phi_components = 0, loads = 0;
+   bool adjacent = false;
+   foreach_list_typed(nir_cf_node, node, node, &loop->body) {
+      if (node == &term->nif->cf_node)
+         continue;
+      if (node->type != nir_cf_node_block)
+         return false;
+      nir_block *block = nir_cf_node_as_block(node);
+      nir_foreach_instr(instr, block) {
+         switch (instr->type) {
+         case nir_instr_type_phi:
+            phi_components += nir_instr_as_phi(instr)->def.num_components;
+            break;
+         case nir_instr_type_alu:
+         case nir_instr_type_load_const:
+            break;
+         case nir_instr_type_intrinsic: {
+            nir_intrinsic_instr *load = nir_instr_as_intrinsic(instr);
+            /* Immutable driver constants and descriptor handles are pure
+             * address-building operations, not loop memory effects.
+             */
+            if (load->intrinsic == nir_intrinsic_load_const_ir3 ||
+                load->intrinsic == nir_intrinsic_bindless_resource_ir3)
+               break;
+            if (block == nir_loop_first_block(loop) ||
+                (load->intrinsic != nir_intrinsic_load_ssbo &&
+                 load->intrinsic != nir_intrinsic_load_ubo) ||
+                load->def.bit_size != 32 || load->def.num_components != 1 ||
+                (nir_intrinsic_access(load) & (ACCESS_VOLATILE | ACCESS_COHERENT)) ||
+                (load->intrinsic == nir_intrinsic_load_ssbo &&
+                 !(nir_intrinsic_access(load) & ACCESS_CAN_REORDER)))
+               return false;
+            uint32_t stride;
+            unsigned shift = nir_intrinsic_has_offset_shift(load) ?
+               nir_intrinsic_offset_shift(load) : 0;
+            if (runtime_stride(loop, load->src[1].ssa, 0, &stride) &&
+                shift <= 2 && stride == (4u >> shift))
+               adjacent = true;
+            loads++;
+            break;
+         }
+         default:
+            return false;
+         }
+      }
+   }
+   return adjacent && loads <= 4 && phi_components <= 12;
+}
+
+/* Share the existing unroller's LCSSA/temporary-register and CF cloning
+ * machinery. All loop-carried values, including floating point accumulators,
+ * flow through each cloned iteration in the original order.
+ */
+static void
+runtime_unroll(nir_loop *loop, unsigned factor, unsigned iv_src)
+{
+   nir_function_impl *impl = nir_cf_node_get_function(&loop->cf_node);
+   nir_loop_terminator *term = list_first_entry(&loop->info->loop_terminator_list,
+                                               nir_loop_terminator,
+                                               loop_terminator_link);
+   loop_prepare_for_unroll(loop);
+   loop->partially_unrolled = true;
+
+   nir_cf_node *parent = loop->cf_node.parent;
+   nir_cursor before = nir_before_cf_node(&loop->cf_node);
+   nir_cf_list original, bulk;
+   struct hash_table *map = _mesa_pointer_hash_table_create(NULL);
+   before = nir_cf_extract(&original, before, nir_after_cf_node(&loop->cf_node));
+   nir_cf_list_clone(&bulk, &original, parent, map);
+   nir_cf_node *first = exec_node_data(nir_cf_node, exec_list_get_head(&bulk.list), node);
+   nir_loop *main = nir_cf_node_as_loop(nir_cf_node_next(first));
+   nir_if *main_if = nir_cf_node_as_if(nir_cf_node_next(&nir_loop_first_block(main)->cf_node));
+   nir_cf_reinsert(&original, before);
+   nir_cf_reinsert(&bulk, nir_before_cf_node(&loop->cf_node));
+   main->partially_unrolled = true;
+
+   nir_builder b = nir_builder_create(impl);
+   b.cursor = nir_before_cf_node(&main_if->cf_node);
+   nir_alu_instr *cmp = nir_def_as_alu(main_if->condition.ssa);
+   nir_def *i = nir_ssa_for_alu_src(&b, cmp, iv_src);
+   nir_def *limit = nir_ssa_for_alu_src(&b, cmp, 1 - iv_src);
+   bool signed_cmp = cmp->op == nir_op_ilt || cmp->op == nir_op_ige;
+   nir_def *last = nir_iadd_imm(&b, i, factor - 1);
+   nir_def *wrap = signed_cmp ? nir_ilt(&b, last, i) : nir_ult(&b, last, i);
+   nir_def *end_cond = nir_build_alu(&b, cmp->op,
+                                    iv_src ? limit : last,
+                                    iv_src ? last : limit, NULL, NULL);
+   /* A wrapping last index must always enter the original scalar loop. */
+   nir_def *cond = term->continue_from_then ?
+      nir_iand(&b, nir_inot(&b, wrap), end_cond) : nir_ior(&b, wrap, end_cond);
+   nir_src_rewrite(&main_if->condition, cond);
+
+   nir_cf_list header, body;
+   nir_cf_extract(&header, nir_before_block(nir_loop_first_block(main)),
+                  nir_before_cf_node(&main_if->cf_node));
+   nir_cf_extract(&body, nir_after_cf_node(&main_if->cf_node),
+                  nir_after_block(nir_loop_last_block(main)));
+   _mesa_hash_table_clear(map, NULL);
+   for (unsigned n = 1; n < factor; n++) {
+      nir_cf_list_clone_and_reinsert(&header, &main->cf_node,
+                                     nir_after_cf_list(&main->body), map);
+      nir_cf_list_clone_and_reinsert(&body, &main->cf_node,
+                                     nir_after_cf_list(&main->body), map);
+   }
+   nir_cf_reinsert(&body, nir_after_cf_node(&main_if->cf_node));
+   nir_cf_reinsert(&header, nir_before_cf_node(&main_if->cf_node));
+   _mesa_hash_table_destroy(map, NULL);
+}
+
+static bool
+runtime_unroll_list(struct exec_list *list, unsigned factor, unsigned max_cost)
+{
+   foreach_list_typed(nir_cf_node, node, node, list) {
+      if (node->type == nir_cf_node_if) {
+         nir_if *nif = nir_cf_node_as_if(node);
+         if (runtime_unroll_list(&nif->then_list, factor, max_cost) ||
+             runtime_unroll_list(&nif->else_list, factor, max_cost))
+            return true;
+      } else if (node->type == nir_cf_node_loop) {
+         nir_loop *loop = nir_cf_node_as_loop(node);
+         unsigned iv_src = 0;
+         if (runtime_unroll_candidate(loop, max_cost, &iv_src)) {
+            runtime_unroll(loop, factor, iv_src);
+            return true;
+         }
+         if (runtime_unroll_list(&loop->body, factor, max_cost))
+            return true;
+      }
+   }
+   return false;
+}
+
+bool
+nir_opt_loop_unroll_runtime(nir_shader *shader, unsigned factor, unsigned max_cost)
+{
+   assert(factor >= 2 && factor <= 4);
+   bool progress = false;
+   nir_foreach_function_impl(impl, shader) {
+      while (true) {
+         nir_metadata_require(impl, nir_metadata_loop_analysis,
+                              shader->options->force_indirect_unrolling,
+                              (int)shader->options->force_indirect_unrolling_sampler);
+         nir_metadata_require(impl, nir_metadata_block_index);
+         if (!runtime_unroll_list(&impl->body, factor, max_cost))
+            break;
+         nir_progress(true, impl, nir_metadata_none);
+         nir_lower_reg_intrinsics_to_ssa_impl(impl);
+         progress = true;
+      }
+   }
+   return progress;
+}
