+static void quantize_test_load(nir_builder *b)
+{
+   nir_foreach_block(block, b->impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         auto *in = nir_instr_as_intrinsic(instr);
+         if (in->intrinsic != nir_intrinsic_load_ssbo)
+            continue;
+         nir_def *index = nir_def_as_alu(in->src[1].ssa)->src[0].src.ssa;
+         b->cursor = nir_before_instr(instr);
+         nir_def *offset = nir_imul_imm(b, nir_idiv(b, index, nir_imm_int(b, 4)), 4);
+         nir_src_rewrite(&in->src[1], offset);
+         return;
+      }
+   }
+}
