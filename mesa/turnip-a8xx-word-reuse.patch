+TEST_F(nir_runtime_unroll_test, cached_word_signed_boundaries)
+{
+   build();
+   quantize_test_load(&bld);
+   nir_shader *original = nir_shader_clone(nullptr, bld.shader);
+   ASSERT_TRUE(nir_opt_loop_cache_readonly(bld.shader));
+   nir_validate_shader(bld.shader, "cached word loop");
+   EXPECT_FALSE(nir_opt_loop_cache_readonly(bld.shader));
+   for (uint32_t start : {0u, 1u, 2u, 3u, 0xfffffff8u, 0xffffffffu, 0x80000000u, 0x7ffffff0u}) {
+      for (unsigned n = 0; n <= 33; n++) {
+         auto a = run(original, start, start + n), b = run(bld.shader, start, start + n);
+         a.reads.erase(std::unique(a.reads.begin(), a.reads.end()), a.reads.end());
+         EXPECT_TRUE(a == b) << "start=" << start << " count=" << n;
+      }
+   }
+   auto empty_a = run(original, 5, 3), empty_b = run(bld.shader, 5, 3);
+   EXPECT_TRUE(empty_a == empty_b) << "reads " << empty_a.reads.size() << "/" << empty_b.reads.size() << " sum " << empty_a.sum << "/" << empty_b.sum;
+   ralloc_free(original);
+}
