From 87afb02bc7e54e6b47da4339a7b805e77751c9b7 Mon Sep 17 00:00:00 2001
From: Job Noorman <jnoorman@igalia.com>
Date: Fri, 6 Nov 2026 17:20:20 +0100
Subject: [PATCH] ir3: move is_cat[23]_float helper up in their file

We need them higher up in the next commit.

Signed-off-by: Job Noorman <jnoorman@igalia.com>
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/46027>
---
 src/freedreno/ir3/instr-a3xx.h | 76 +++++++++++++++++-----------------
 1 file changed, 38 insertions(+), 38 deletions(-)

diff --git a/src/freedreno/ir3/instr-a3xx.h b/src/freedreno/ir3/instr-a3xx.h
index 6f6e6a41277..f4cf75e83e8 100644
--- a/src/freedreno/ir3/instr-a3xx.h
+++ b/src/freedreno/ir3/instr-a3xx.h
@@ -609,6 +609,44 @@ typedef enum {
    CAT6_BINDLESS_NONUNIFORM = 6,
 } cat6_desc_mode_t;
 
+static inline bool
+is_cat2_float(opc_t opc)
+{
+   switch (opc) {
+   case OPC_ADD_F:
+   case OPC_MIN_F:
+   case OPC_MAX_F:
+   case OPC_MUL_F:
+   case OPC_SIGN_F:
+   case OPC_CMPS_F:
+   case OPC_ABSNEG_F:
+   case OPC_CMPV_F:
+   case OPC_FLOOR_F:
+   case OPC_CEIL_F:
+   case OPC_RNDNE_F:
+   case OPC_RNDAZ_F:
+   case OPC_TRUNC_F:
+      return true;
+
+   default:
+      return false;
+   }
+}
+
+static inline bool
+is_cat3_float(opc_t opc)
+{
+   switch (opc) {
+   case OPC_MAD_F16:
+   case OPC_MAD_F32:
+   case OPC_SEL_F16:
+   case OPC_SEL_F32:
+      return true;
+   default:
+      return false;
+   }
+}
+
 static inline bool
 is_sat_compatible(opc_t opc)
 {
@@ -792,44 +830,6 @@ is_isam(opc_t opc)
    }
 }
 
-static inline bool
-is_cat2_float(opc_t opc)
-{
-   switch (opc) {
-   case OPC_ADD_F:
-   case OPC_MIN_F:
-   case OPC_MAX_F:
